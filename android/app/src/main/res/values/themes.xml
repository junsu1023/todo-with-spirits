<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TodoWithSpirits" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      콜드 스타트 때 안드로이드가 강제로 띄우는 시스템 스플래시.
      배경을 Compose SplashScreen(surfaceColor1 = 흰색)과 동일하게 맞춰서,
      첫 프레임이 그려지는 순간 내가 만든 SplashScreen 으로 이음새 없이 넘어가게 한다.
      (12+ 에서는 이 창 자체를 제거할 수 없고, 짧게 흰 배경 + 아이콘만 스쳐 지나간다.)
    -->
    <style name="Theme.TodoWithSpirits.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TodoWithSpirits</item>
    </style>
</resources>
