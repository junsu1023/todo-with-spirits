<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TodoSpirits.Windows.Views">

    <!-- 앱에 넣어 둔 나눔스퀘어라운드(400·700·800). 읽지 못하면 맑은 고딕 -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#NanumSquareRound, Malgun Gothic</FontFamily>

    <!-- 그림자(CardShadow · LiftShadow · FloatShadow · ModalShadow · LimeGlow)는 테마 사전에 있다: 다크에서 값이 달라서 -->

    <!-- 글자색·글꼴·크기는 창에서 물려받는다. 여기서 색을 정하면 버튼 안 글자까지 덮어써서 버튼 글자색이 틀어진다 -->
    <Style TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 모양을 따로 정하지 않은 버튼(달력 칸 등)도 글자색은 테마를 따른다 -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <!-- 초점 표시: 키보드로 옮겨 갈 때만 보인다 (마우스로 누를 때는 안 보임) -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Focus}" BorderThickness="3" CornerRadius="16" Margin="-5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 바탕 없는 기본 버튼. Tag 에 아이콘(Geometry)을 주면 글자 앞에 그린다 -->
    <Style x:Key="Flat" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding (v:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="press"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <v:Icon x:Name="ic" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                    Width="{Binding (v:Ui.IconSize), RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding (v:Ui.IconSize), RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,7,0"
                                    Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Margin" Value="0"/>
                        </Trigger>
                        <!-- 누르는 순간 살짝 작아진다 (시안 :active scale .97) -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Back02}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource GreyOff}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 알약 모양 보조 버튼 -->
    <Style x:Key="Pill" TargetType="Button" BasedOn="{StaticResource Flat}">
        <Setter Property="Background" Value="{DynamicResource Back02}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="v:Ui.Radius" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 라임 주 버튼: 아래로 번지는 라임 빛 -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
        <Setter Property="Background" Value="{DynamicResource Lime}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnLime}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Effect" Value="{DynamicResource LimeGlow}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LimeHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Back02}"/>
                <Setter Property="Foreground" Value="{DynamicResource GreyOff}"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 사이드바 버튼 -->
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Flat}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- 동그란 아이콘 버튼 (검색 · 이전/다음 · 닫기 등). Tag = 아이콘 -->
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Flat}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="v:Ui.Radius" Value="21"/>
        <Setter Property="v:Ui.IconSize" Value="22"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- 제목 표시줄 버튼 -->
    <Style x:Key="TitleBtn" TargetType="Button" BasedOn="{StaticResource Flat}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <v:Icon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="14" Height="14" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TitleCtl" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Back02}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TitleClose" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CloseHover}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 카드 모양 버튼 (일정 한 줄): 옅은 그림자, 마우스를 올리면 테두리와 그림자가 짙어진다. v:Ui.Selected=True 면 선택(상세가 열린 줄) -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ring" Margin="-4" CornerRadius="22" Background="{DynamicResource SelRing}" Visibility="Collapsed"/>
                        <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Padding="18,10,16,10" MinHeight="64"
                                Effect="{DynamicResource CardShadow}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                            <Setter TargetName="b" Property="Effect" Value="{DynamicResource LiftShadow}"/>
                        </Trigger>
                        <Trigger Property="v:Ui.Selected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelB}"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 완료 동그라미: Tag=True 면 채워짐. 마우스를 올리면 라임 테두리와 옅은 체크가 미리 보인다 -->
    <Style x:Key="Check" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="press"/>
                        </Grid.RenderTransform>
                        <Ellipse x:Name="e" Stroke="{DynamicResource CheckB}" StrokeThickness="2" Fill="Transparent"/>
                        <Path x:Name="p" Data="M6,12.5 L10.5,17 L18,8" Stroke="{DynamicResource OnText}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                        <Path x:Name="hint" Data="M6,12.5 L10.5,17 L18,8" Stroke="{DynamicResource LimeT}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="e" Property="Stroke" Value="{DynamicResource Lime}"/>
                            <Setter TargetName="e" Property="Fill" Value="{DynamicResource LimeOp}"/>
                            <Setter TargetName="hint" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="e" Property="Fill" Value="{DynamicResource CheckDone}"/>
                            <Setter TargetName="e" Property="Stroke" Value="{DynamicResource CheckDone}"/>
                            <Setter TargetName="p" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                    <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- 작은 꼬리표 (오늘 · 다음 일정 · 이번 달) -->
    <Style x:Key="LimeTag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LimeOp}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Lime}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" Margin="-4" CornerRadius="18" Background="{DynamicResource SelRing}" Visibility="Collapsed"/>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1.5" CornerRadius="14" Padding="14,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelB}"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 켜고 끄는 스위치: 손잡이가 미끄러진다 -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" Width="48" Height="28" CornerRadius="14" Background="{DynamicResource SwitchOff}">
                        <Ellipse Width="22" Height="22" Fill="{DynamicResource Knob}" HorizontalAlignment="Left" Margin="3,0" Effect="{DynamicResource KnobShadow}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="slide"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource SwitchOn}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 얇고 둥근 스크롤 막대 -->
    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{DynamicResource Scroll}" CornerRadius="2" Margin="3,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource SelB}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 둥근 진행 막대 -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource Pink}"/>
        <Setter Property="Background" Value="{DynamicResource Track}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 말풍선 -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OnText}"/>
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="VerticalOffset" Value="6"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Text}" CornerRadius="8" Padding="9,5">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 우클릭 메뉴 -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="16,6,16,34" Background="{DynamicResource Elev}" BorderBrush="{DynamicResource ElevRing}" BorderThickness="1" CornerRadius="16" Padding="6"
                            Effect="{DynamicResource FloatShadow}" MinWidth="196" v:Motion.Enter="Menu">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,5" Background="{DynamicResource Stroke}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="12,0" Height="36">
                        <DockPanel VerticalAlignment="Center">
                            <v:Icon DockPanel.Dock="Left" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17" Margin="0,0,10,0" Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" FontSize="11" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource MenuHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
