<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
                    xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels">

    <v:EqVis x:Key="EqVis"/>
    <v:BoolVis x:Key="BoolVis"/>
    <v:SameText x:Key="SameText"/>

    <!-- 일정 카드의 우클릭 메뉴. 메뉴는 화면 나무 밖에 있어서, 카드의 Tag(화면 상태)와 DataContext(일정)를 건너서 쓴다.
         글자는 일정의 지금 상태에 따라 바뀐다 (완료 ↔ 완료 취소). 오른쪽은 카드에 초점이 있을 때의 단축키 -->
    <ContextMenu x:Key="TaskMenu">
        <MenuItem Header="{Binding PlacementTarget.DataContext.DoneMenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Tag="{StaticResource IcCheck}" InputGestureText="Space"
                  Command="{Binding PlacementTarget.Tag.ToggleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="{Binding PlacementTarget.DataContext.ImportantMenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Tag="{StaticResource IcStar}"
                  Command="{Binding PlacementTarget.Tag.ToggleImportantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="자세히 보기" Tag="{StaticResource IcPencil}" InputGestureText="Enter"
                  Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Header="내일로 미루기" Tag="{StaticResource IcCal}"
                  Command="{Binding PlacementTarget.Tag.PostponeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <Separator/>
        <MenuItem Header="삭제" Tag="{StaticResource IcTrash}" Foreground="{DynamicResource Del}" InputGestureText="Del"
                  Command="{Binding PlacementTarget.Tag.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    </ContextMenu>

    <!-- 카드 둘째 줄의 작은 표시 (반복 · 알림): 12px 아이콘 + 글자 -->
    <Style x:Key="MetaIcon" TargetType="v:Icon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,3,0"/>
    </Style>

    <!-- 일정 한 줄: 동그라미(완료) · 제목 ★ · 시간. 눌러서 상세, 우클릭으로 메뉴.
         카드에 초점이 있으면 Space=완료, Enter=상세, Delete=삭제 (MainWindow 가 처리) -->
    <DataTemplate x:Key="TaskCard" DataType="{x:Type vm:TaskRow}">
        <Button x:Name="card" Style="{StaticResource CardButton}" ContextMenu="{StaticResource TaskMenu}" v:Ui.Selected="{Binding IsSelected}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}"
                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <ScaleTransform/>
            </Button.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" VerticalAlignment="Center">
                    <!-- 완료하는 순간 퍼지는 라임 고리 -->
                    <Ellipse x:Name="ring" Stroke="{DynamicResource Lime}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                        <Ellipse.RenderTransform>
                            <ScaleTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Button x:Name="ck" Style="{StaticResource Check}" Tag="{Binding Done}" ToolTip="완료 표시" AutomationProperties.Name="완료 표시" RenderTransformOrigin="0.5,0.5"
                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                        <Button.RenderTransform>
                            <ScaleTransform/>
                        </Button.RenderTransform>
                    </Button>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="title" Text="{Binding Title}" FontSize="15" FontWeight="Bold"/>
                        <v:Icon x:Name="star" Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="15" Height="15" Foreground="{DynamicResource Pink}" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Important, Converter={StaticResource BoolVis}}"/>
                        <Border Background="{DynamicResource LimeOp}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="남은 날"
                                Visibility="{Binding HasDday, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding DdayText}" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}"/>
                        </Border>
                    </StackPanel>
                    <WrapPanel Margin="0,3,0,0">
                        <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                        <TextBlock Text="{Binding OverdueText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PinkB}"/>
                        <StackPanel Orientation="Horizontal" ToolTip="반복" Visibility="{Binding HasRepeat, Converter={StaticResource BoolVis}}">
                            <v:Icon Data="{StaticResource IcRepeat}" Style="{StaticResource MetaIcon}"/>
                            <TextBlock Text="{Binding RepeatText}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" ToolTip="알림" Visibility="{Binding HasAlarm, Converter={StaticResource BoolVis}}">
                            <v:Icon Data="{StaticResource IcBell}" Style="{StaticResource MetaIcon}"/>
                            <TextBlock Text="{Binding AlarmText}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                <v:Icon Grid.Column="2" Data="{StaticResource IcChevRight}" Width="18" Height="18" Foreground="{DynamicResource Chev}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Done}" Value="True">
                <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Grey}"/>
                <Setter TargetName="title" Property="FontWeight" Value="Normal"/>
                <Setter TargetName="star" Property="Opacity" Value="0.5"/>
            </DataTrigger>
            <!-- 방금 완료한 줄: 체크가 톡 튀고(checkpop) 라임 고리가 퍼진다(ring) -->
            <DataTrigger Binding="{Binding JustDone}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ck" Storyboard.TargetProperty="RenderTransform.ScaleX" Duration="0:0:0.42">
                                <LinearDoubleKeyFrame KeyTime="0%" Value="1"/><LinearDoubleKeyFrame KeyTime="35%" Value="1.28"/><LinearDoubleKeyFrame KeyTime="70%" Value="0.92"/><LinearDoubleKeyFrame KeyTime="100%" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ck" Storyboard.TargetProperty="RenderTransform.ScaleY" Duration="0:0:0.42">
                                <LinearDoubleKeyFrame KeyTime="0%" Value="1"/><LinearDoubleKeyFrame KeyTime="35%" Value="1.28"/><LinearDoubleKeyFrame KeyTime="70%" Value="0.92"/><LinearDoubleKeyFrame KeyTime="100%" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetName="title" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
            <!-- 방금 추가한 줄: 톡 튀어나오며 나타난다(popin) -->
            <DataTrigger Binding="{Binding JustNew}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="card" Storyboard.TargetProperty="RenderTransform.ScaleX" Duration="0:0:0.42">
                                <LinearDoubleKeyFrame KeyTime="0%" Value="0.92"/><LinearDoubleKeyFrame KeyTime="60%" Value="1.02"/><LinearDoubleKeyFrame KeyTime="100%" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="card" Storyboard.TargetProperty="RenderTransform.ScaleY" Duration="0:0:0.42">
                                <LinearDoubleKeyFrame KeyTime="0%" Value="0.92"/><LinearDoubleKeyFrame KeyTime="60%" Value="1.02"/><LinearDoubleKeyFrame KeyTime="100%" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 어제 하지 못한 일: 점선 테두리 · 옅은 바탕 · 그림자 없음. 직접 "오늘 하기"나 "다른 날"을 고른다 -->
    <DataTemplate x:Key="CarryCard" DataType="{x:Type vm:TaskRow}">
        <Button ContextMenu="{StaticResource TaskMenu}" Cursor="Hand" Margin="0,0,0,10" HorizontalContentAlignment="Stretch" FocusVisualStyle="{StaticResource FocusRing}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}" v:Ui.Selected="{Binding IsSelected}"
                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid MinHeight="64">
                        <Border x:Name="ring" Margin="-4" CornerRadius="22" Background="{DynamicResource SelRing}" Visibility="Collapsed"/>
                        <Rectangle x:Name="r" RadiusX="18" RadiusY="18" Fill="{DynamicResource CarryBg}" Stroke="{DynamicResource CarryB}" StrokeThickness="1" StrokeDashArray="4 3"/>
                        <ContentPresenter Margin="18,10,12,10" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="r" Property="Stroke" Value="{DynamicResource SelB}"/>
                        </Trigger>
                        <Trigger Property="v:Ui.Selected" Value="True">
                            <Setter TargetName="r" Property="Stroke" Value="{DynamicResource SelB}"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Check}" Tag="{Binding Done}" ToolTip="완료 표시" AutomationProperties.Name="완료 표시"
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"/>
                        <v:Icon Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="15" Height="15" Foreground="{DynamicResource Pink}" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Important, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CarrySub}" FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="오늘 하기" Foreground="{DynamicResource OnLime}" Margin="0,0,6,0"
                            Command="{Binding DataContext.MoveToTodayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Pill}">
                                <Setter Property="Background" Value="{DynamicResource Lime}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource LimeB}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="다른 날" Style="{StaticResource Pill}" ToolTip="날짜를 골라 옮기기"
                            Command="{Binding DataContext.PickDateForCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
