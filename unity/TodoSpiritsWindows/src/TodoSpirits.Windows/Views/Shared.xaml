<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
                    xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels">

    <v:EqVis x:Key="EqVis"/>
    <v:BoolVis x:Key="BoolVis"/>

    <!-- 일정 한 줄: 동그라미(완료) · 제목 ★ · 시간. 눌러서 상세 -->
    <DataTemplate x:Key="TaskCard" DataType="{x:Type vm:TaskRow}">
        <Button Style="{StaticResource CardButton}"
                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Check}" Tag="{Binding Done}" ToolTip="완료 표시"
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="title" Text="{Binding Title}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="★" Foreground="{DynamicResource Pink}" FontSize="14" Margin="6,0,0,0"
                                   Visibility="{Binding Important, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <TextBlock x:Name="sub" Text="{Binding Sub}" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" Margin="8,0,2,0"/>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Done}" Value="True">
                <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Text2}"/>
                <Setter TargetName="title" Property="FontWeight" Value="Normal"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource Del}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 어제 하지 못한 일: 직접 "오늘 하기"를 고른다 -->
    <DataTemplate x:Key="CarryCard" DataType="{x:Type vm:TaskRow}">
        <Button Style="{StaticResource CardButton}"
                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Check}" Tag="{Binding Done}" ToolTip="완료 표시"
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="★" Foreground="{DynamicResource Pink}" FontSize="14" Margin="6,0,0,0"
                                   Visibility="{Binding Important, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CarrySub}" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="오늘 하기" Style="{StaticResource Pill}" Background="{DynamicResource Lime}" Foreground="{DynamicResource OnLime}"
                        Command="{Binding DataContext.MoveToTodayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
