<UserControl x:Class="TodoSpirits.Windows.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
             xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels">
    <UserControl.Resources>
        <!-- 보기 전환 버튼 (.viewseg button): 높이 32 알약, 마우스를 올리면 글자색만 바뀐다 -->
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 이전 · 다음 (.monthnav button): 36px, 아이콘 20 -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="v:Ui.Radius" Value="18"/>
            <Setter Property="v:Ui.IconSize" Value="20"/>
        </Style>

        <!-- 주간 띠의 하루 -->
        <DataTemplate x:Key="WeekDay" DataType="{x:Type vm:DayCell}">
            <Button Cursor="Hand" Margin="4,0" ToolTip="{Binding Tip}" FocusVisualStyle="{StaticResource FocusRing}"
                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="lift"/>
                        </Grid.RenderTransform>
                        <Border x:Name="ring" Margin="-3" CornerRadius="21" Background="{DynamicResource SelRing}" Visibility="Collapsed"/>
                        <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Padding="4,9" Effect="{DynamicResource CardShadow}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="dow" Text="{Binding DowLabel}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="num" Text="{Binding Num}" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="11" Height="11" Margin="0,0,4,0" Foreground="{DynamicResource Pink}" VerticalAlignment="Center"
                                               Visibility="{Binding HasImportant, Converter={StaticResource BoolVis}}"/>
                                    <v:Icon Data="{StaticResource IcCheck}" Thickness="2.4" Width="11" Height="11" Margin="0,0,3,0" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"
                                            Visibility="{Binding ShowAllDone, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock x:Name="cnt" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Text2}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                <Setter TargetName="cnt" Property="Foreground" Value="{DynamicResource Grey}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource LimeOp}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LimeRing}"/>
                                <Setter TargetName="dow" Property="Foreground" Value="{DynamicResource LimeT}"/>
                                <Setter TargetName="dow" Property="FontWeight" Value="ExtraBold"/>
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Text}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- 월간 칸: 날짜 + 첫 일정 제목 한 줄 + "외 n개" -->
        <DataTemplate x:Key="MonthDay" DataType="{x:Type vm:DayCell}">
            <Button Cursor="Hand" Margin="2" ToolTip="{Binding Tip}" FocusVisualStyle="{StaticResource FocusRing}" MouseDoubleClick="OnDayDoubleClick"
                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                        <Border x:Name="ring" Margin="-3" CornerRadius="17" Background="{DynamicResource SelRing}" Visibility="Collapsed"/>
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="8,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="num" Text="{Binding Num}" FontSize="16" FontWeight="ExtraBold"/>
                                    <TextBlock Text="오늘" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}" Margin="6,0,0,1" VerticalAlignment="Bottom"
                                               Visibility="{Binding IsToday, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <DockPanel Margin="0,2,0,0" Visibility="{Binding ShowFirst, Converter={StaticResource BoolVis}}">
                                    <v:Icon DockPanel.Dock="Left" Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="11" Height="11" Margin="0,0,4,0" Foreground="{DynamicResource Pink}" VerticalAlignment="Center"
                                               Visibility="{Binding FirstImportant, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding FirstTitle}" FontSize="12"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <v:Icon Data="{StaticResource IcCheck}" Thickness="2.4" Width="11" Height="11" Margin="0,0,3,0" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"
                                            Visibility="{Binding ShowAllDone, Converter={StaticResource BoolVis}}"/>
                                    <v:Icon Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="10" Height="10" Margin="0,0,3,0" Foreground="{DynamicResource Pink}" VerticalAlignment="Center"
                                            Visibility="{Binding ShowRestStar, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding RestText}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 빠른 추가: 이번 달 칸에 마우스를 올리면 오른쪽 위에 뜬다 -->
                        <Button x:Name="plus" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="Collapsed" Tag="{StaticResource IcPlus}"
                                ToolTip="이 날 일정 추가" AutomationProperties.Name="이 날 일정 추가" v:Ui.Radius="11" v:Ui.IconSize="13" Padding="0" HorizontalContentAlignment="Center"
                                Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Flat}">
                                    <Setter Property="Background" Value="{DynamicResource Card}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                                    <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Lime}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnLime}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Text2}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOther}" Value="True">
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Grey}"/>
                                <Setter TargetName="num" Property="FontWeight" Value="Normal"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Back02}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource LimeOp}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource LimeRing}"/>
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Text}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding CanQuickAdd}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="plus" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- 연간의 하루 숫자 -->
        <DataTemplate x:Key="YearDay" DataType="{x:Type vm:DayCell}">
            <Button Cursor="Hand" Height="21" Margin="1" ToolTip="{Binding Tip}" FocusVisualStyle="{StaticResource FocusRing}"
                    Visibility="{Binding IsBlank, Converter={StaticResource BoolVis}, ConverterParameter=inv-hide}"
                    Command="{Binding DataContext.YearDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <TextBlock x:Name="t" Text="{Binding Num}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource Pink}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0"
                                         Visibility="{Binding HasImportant, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Heat}" Value="1">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Heat1}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Heat}" Value="2">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Heat2}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Lime}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource OnLime}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="ExtraBold"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Seven">
            <UniformGrid Columns="7"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid x:Name="Rows" v:Motion.Stagger="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 머리 74: 기간 · 이전/다음 · 오늘 · 검색 · 알림 -->
        <Grid Height="74">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PeriodTitle}" FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource NavBtn}" Tag="{StaticResource IcChevLeft}" ToolTip="이전 (PageUp)" AutomationProperties.Name="이전" Command="{Binding PrevCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource NavBtn}" Tag="{StaticResource IcChevRight}" ToolTip="다음 (PageDown)" AutomationProperties.Name="다음" Command="{Binding NextCommand}" Margin="0,0,8,0"/>
                <Button Content="오늘" Style="{StaticResource Pill}" Command="{Binding GoTodayCommand}"/>
            </StackPanel>
            <v:HeaderTools HorizontalAlignment="Right"/>
        </Grid>

        <!-- 보기 전환 + 안내 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Border Background="{DynamicResource Back02}" CornerRadius="20" Padding="2,4" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Button Content="주간" ToolTip="주간 (W)" CommandParameter="week" Command="{Binding SetModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Seg}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CalMode}" Value="week">
                                        <Setter Property="Background" Value="{DynamicResource SegOn}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="월간" ToolTip="월간 (M)" CommandParameter="month" Command="{Binding SetModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Seg}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CalMode}" Value="month">
                                        <Setter Property="Background" Value="{DynamicResource SegOn}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="연간" ToolTip="연간 (Y)" CommandParameter="year" Command="{Binding SetModeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Seg}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CalMode}" Value="year">
                                        <Setter Property="Background" Value="{DynamicResource SegOn}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding CalHint}" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                <!-- 연간 범례 -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Visibility="{Binding CalMode, Converter={StaticResource EqVis}, ConverterParameter=year}">
                    <Border Width="12" Height="12" CornerRadius="4" Background="{DynamicResource Heat1}" VerticalAlignment="Center"/>
                    <TextBlock Text="일정 1개" FontSize="12" Foreground="{DynamicResource Text2}" Margin="5,0,12,0" VerticalAlignment="Center"/>
                    <Border Width="12" Height="12" CornerRadius="4" Background="{DynamicResource Heat2}" VerticalAlignment="Center"/>
                    <TextBlock Text="2개 이상" FontSize="12" Foreground="{DynamicResource Text2}" Margin="5,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Pink}" VerticalAlignment="Center"/>
                    <TextBlock Text="중요" FontSize="12" Foreground="{DynamicResource Text2}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 주간: 한 주 띠 + 고른 날 목록 -->
        <Grid x:Name="WeekView" Grid.Row="2" Visibility="{Binding CalMode, Converter={StaticResource EqVis}, ConverterParameter=week}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding WeekCells}" ItemTemplate="{StaticResource WeekDay}" ItemsPanel="{StaticResource Seven}" Margin="-4,3,-4,12" Focusable="False"/>
            <!-- 목록 머리: "13일 화요일" 오늘 · n개 … 일정 추가 -->
            <Grid Grid.Row="1" Margin="4,4,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WeekTitle}" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource LimeTag}" Margin="8,0,0,0" Visibility="{Binding SelectedIsToday, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="오늘" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}"/>
                    </Border>
                    <TextBlock Text="{Binding WeekStat}" FontSize="13" Foreground="{DynamicResource Text2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="일정 추가" Tag="{StaticResource IcPlus}" Style="{StaticResource Flat}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" Padding="9,6,12,6"
                        HorizontalAlignment="Right" ToolTip="Ctrl+N" AutomationProperties.Name="일정 추가" v:Ui.Radius="16" v:Ui.IconSize="15" Command="{Binding AddCommand}"/>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="-6,0,-16,0" Padding="6,0,16,0" MouseDoubleClick="OnListDoubleClick" Background="Transparent">
                <StackPanel x:Name="WeekList" Margin="0,0,0,24">
                    <ItemsControl ItemsSource="{Binding DayTasks}" ItemTemplate="{StaticResource TaskCard}" Focusable="False"/>
                    <TextBlock Text="{Binding DayEmptyText}" FontSize="14" Foreground="{DynamicResource Grey}" Margin="6,10,0,0" Visibility="{Binding DayEmpty, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 월간: 달력. 고른 날의 목록은 창 오른쪽 패널(DayPanel)에 있다 -->
        <Border x:Name="MonthView" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8,6,8,8" Margin="0,0,0,22"
                Visibility="{Binding CalMode, Converter={StaticResource EqVis}, ConverterParameter=month}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UniformGrid Columns="7">
                    <TextBlock Text="일" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="월" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="화" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="수" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="목" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="금" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="토" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </UniformGrid>
                <ItemsControl x:Name="MonthGrid" Grid.Row="1" ItemsSource="{Binding MonthCells}" ItemTemplate="{StaticResource MonthDay}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="{Binding MonthRows}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 연간: 12달 -->
        <ScrollViewer x:Name="YearView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0"
                      Visibility="{Binding CalMode, Converter={StaticResource EqVis}, ConverterParameter=year}">
            <ItemsControl ItemsSource="{Binding YearCards}" Margin="-5,0,-5,14" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonthCard}">
                        <Border x:Name="card" Style="{StaticResource CardBorder}" Padding="12,6,12,8" Margin="5,4">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Flat}" Content="{Binding Name}" FontSize="16" FontWeight="ExtraBold" Padding="8,2" Margin="-8,0,0,0"
                                                Command="{Binding DataContext.GoMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Border Background="{DynamicResource LimeOp}" CornerRadius="9" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="이번 달" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Text2}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <UniformGrid Columns="7" Margin="0,0,0,2">
                                    <TextBlock Text="일" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="월" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="화" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="수" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="목" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="금" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="토" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource YearDay}" ItemsPanel="{StaticResource Seven}" Focusable="False"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource LimeB}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
