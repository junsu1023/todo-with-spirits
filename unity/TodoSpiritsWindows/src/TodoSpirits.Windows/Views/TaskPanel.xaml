<UserControl x:Class="TodoSpirits.Windows.Views.TaskPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
             xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels"
             IsVisibleChanged="OnVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="RowIcon" TargetType="v:Icon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Line" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Stroke}"/>
        </Style>

        <!-- 휠의 앞뒤 값: 흐리게 보이고, 누르면 그쪽으로 넘어간다 -->
        <Style x:Key="WheelSide" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Grey}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 하나만 고르는 알약 묶음 (반복 · 알림) -->
        <Style x:Key="SegItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="11" Padding="4,7">
                            <TextBlock x:Name="t" Text="{Binding}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                                <Setter TargetName="b" Property="Effect" Value="{StaticResource CardShadow}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Seg" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SegItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{DynamicResource Back02}" CornerRadius="14" Padding="3">
                            <UniformGrid Rows="1" IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 반복 요일 · 날짜 칩 -->
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:DayChip}">
            <Button Cursor="Hand" Margin="2" Height="32" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Label}"
                    Command="{Binding DataContext.ToggleRepeatDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="9">
                            <TextBlock x:Name="t" Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource Grey}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Text}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource OnText}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- 작은 달력의 하루 -->
        <DataTemplate x:Key="MiniDay" DataType="{x:Type vm:MiniDay}">
            <Button Cursor="Hand" Height="34" Margin="1" FocusVisualStyle="{StaticResource FocusRing}"
                    Command="{Binding DataContext.PickEditDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="17" Width="34">
                            <TextBlock x:Name="t" Text="{Binding Num}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOther}" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Grey}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Back02}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource LimeOp}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="ExtraBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Text}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource OnText}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="ExtraBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0">
        <Grid Margin="22,0,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="{Binding PanelTitle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconBtn}" Tag="{StaticResource IcX}" HorizontalAlignment="Right" ToolTip="닫기 (Esc)" AutomationProperties.Name="닫기"
                        Command="{Binding ClosePanelCommand}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                <StackPanel Margin="0,0,0,14">
                    <TextBox x:Name="TitleBox" Height="52" FontSize="17" FontWeight="Bold" AutomationProperties.Name="일정 제목"
                             Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnTitleKeyDown"/>
                    <TextBlock Text="제목을 입력해 주세요" FontSize="12" Foreground="{DynamicResource Grey}" Margin="6,6,0,0"
                               Visibility="{Binding IsNew, Converter={StaticResource BoolVis}}"/>

                    <!-- 중요 -->
                    <Border Style="{StaticResource CardBorder}" Padding="16,0" Margin="0,16,0,0">
                        <Grid Height="52">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <v:Icon Data="{StaticResource IcStar}" Style="{StaticResource RowIcon}"/>
                                <TextBlock Text="중요" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" AutomationProperties.Name="중요" IsChecked="{Binding EditImportant}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- 날짜 · 시간 · 반복 · 알림 -->
                    <Border Style="{StaticResource CardBorder}" Padding="16,0" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Height="52">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcCal}" Style="{StaticResource RowIcon}"/>
                                    <TextBlock Text="{Binding EditDateLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="{Binding EditDateText}" Style="{StaticResource Flat}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,-10,0"
                                        ToolTip="달력 펼치기 / 접기" AutomationProperties.Name="날짜 고르기" Command="{Binding ToggleEditCalCommand}"/>
                            </Grid>
                            <!-- 작은 달력 -->
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding EditCalOpen, Converter={StaticResource BoolVis}}" v:Motion.Enter="Fade">
                                <Grid Margin="0,0,0,6">
                                    <Button Style="{StaticResource IconBtn}" Width="30" Height="30" Tag="{StaticResource IcChevLeft}" HorizontalAlignment="Left" ToolTip="이전 달" Command="{Binding EditCalPrevCommand}"/>
                                    <TextBlock Text="{Binding EditCalTitle}" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource IconBtn}" Width="30" Height="30" Tag="{StaticResource IcChevRight}" HorizontalAlignment="Right" ToolTip="다음 달" Command="{Binding EditCalNextCommand}"/>
                                </Grid>
                                <UniformGrid Columns="7" Margin="0,0,0,2">
                                    <TextBlock Text="일" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="월" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="화" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="수" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="목" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="금" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="토" FontSize="11" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding EditCalCells}" ItemTemplate="{StaticResource MiniDay}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <Border Style="{StaticResource Line}"/>
                            <Grid Height="52">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcClock}" Style="{StaticResource RowIcon}"/>
                                    <TextBlock Text="시간" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditTimeText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <CheckBox Style="{StaticResource Switch}" AutomationProperties.Name="시간 정하기" IsChecked="{Binding EditHasTime}"/>
                                </StackPanel>
                            </Grid>
                            <!-- 시간 휠: 가운데가 고른 값. 마우스 휠을 굴리거나 위아래 값을 누른다. 분은 5분씩 -->
                            <Grid Margin="0,0,0,14" Visibility="{Binding EditHasTime, Converter={StaticResource BoolVis}}" v:Motion.Enter="Fade">
                                <Border Background="{DynamicResource Back02}" CornerRadius="14"/>
                                <Border Background="{DynamicResource Card}" CornerRadius="10" Height="36" Margin="8,0" VerticalAlignment="Center" Effect="{StaticResource CardShadow}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                                    <TextBlock Text="{Binding EditAmPm}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Background="Transparent" MouseWheel="OnHourWheel" ToolTip="마우스 휠로도 바꿀 수 있어요">
                                        <Button Style="{StaticResource WheelSide}" Content="{Binding EditHourPrev}" AutomationProperties.Name="시 내리기" Command="{Binding HourDownCommand}"/>
                                        <TextBlock Text="{Binding EditHour12}" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Height="36" Padding="0,4,0,0"/>
                                        <Button Style="{StaticResource WheelSide}" Content="{Binding EditHourNext}" AutomationProperties.Name="시 올리기" Command="{Binding HourUpCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text=":" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="2,0,2,3"/>
                                    <StackPanel Background="Transparent" MouseWheel="OnMinuteWheel" ToolTip="마우스 휠로도 바꿀 수 있어요">
                                        <Button Style="{StaticResource WheelSide}" Content="{Binding EditMinutePrev}" AutomationProperties.Name="분 내리기" Command="{Binding MinuteDownCommand}"/>
                                        <TextBlock Text="{Binding EditMinuteText}" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Height="36" Padding="0,4,0,0"/>
                                        <Button Style="{StaticResource WheelSide}" Content="{Binding EditMinuteNext}" AutomationProperties.Name="분 올리기" Command="{Binding MinuteUpCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- 반복 -->
                            <Border Style="{StaticResource Line}"/>
                            <Grid Height="52">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcRepeat}" Style="{StaticResource RowIcon}"/>
                                    <TextBlock Text="반복" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding EditRepeatSummary}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="210"/>
                            </Grid>
                            <ListBox Style="{StaticResource Seg}" ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding EditRepeat}" Margin="0,0,0,12" AutomationProperties.Name="반복"/>
                            <ItemsControl ItemsSource="{Binding WeekdayChips}" ItemTemplate="{StaticResource Chip}" Margin="-2,0,-2,12" Focusable="False"
                                          Visibility="{Binding EditIsWeekly, Converter={StaticResource BoolVis}}" v:Motion.Enter="Fade">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding MonthDayChips}" ItemTemplate="{StaticResource Chip}" Margin="-2,0,-2,12" Focusable="False"
                                          Visibility="{Binding EditIsMonthly, Converter={StaticResource BoolVis}}" v:Motion.Enter="Fade">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- 알림 -->
                            <Border Style="{StaticResource Line}"/>
                            <Grid Height="52">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcBell}" Style="{StaticResource RowIcon}"/>
                                    <TextBlock Text="알림" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="시간을 정하면 알림을 받을 수 있어요" FontSize="12" Foreground="{DynamicResource Grey}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Visibility="{Binding EditHasTime, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>
                                <TextBlock Text="{Binding EditAlarm}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Visibility="{Binding EditHasTime, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                            <ListBox Style="{StaticResource Seg}" ItemsSource="{Binding AlarmOptions}" SelectedItem="{Binding EditAlarm}" Margin="0,0,0,14" AutomationProperties.Name="알림"
                                     Visibility="{Binding EditHasTime, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="변경 내용은 바로 저장돼요" FontSize="12" Foreground="{DynamicResource Text2}" Margin="6,10,0,0"
                               Visibility="{Binding IsExisting, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="반복 일정은 완료가 날짜마다 따로 기록돼요. 삭제하면 모든 날짜에서 사라져요." FontSize="12" Foreground="{DynamicResource Text2}" Margin="6,6,0,0"
                               TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding EditIsRepeating, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Style="{StaticResource Primary}" Content="확인" Command="{Binding SaveCommand}"
                    Visibility="{Binding IsNew, Converter={StaticResource BoolVis}}"/>
            <UniformGrid Grid.Row="2" Columns="2" Visibility="{Binding IsExisting, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource Pill}" Content="삭제" Tag="{StaticResource IcTrash}" Height="50" FontSize="15" Margin="0,0,5,0" HorizontalContentAlignment="Center"
                        Foreground="{DynamicResource Del}" Background="{DynamicResource DelBg}" Command="{Binding DeleteCommand}"/>
                <Button Style="{StaticResource Pill}" Content="{Binding EditDoneLabel}" Tag="{StaticResource IcCheck}" Height="50" FontSize="15" Margin="5,0,0,0" HorizontalContentAlignment="Center"
                        Command="{Binding ToggleEditingCommand}"/>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
