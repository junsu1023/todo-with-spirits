<UserControl x:Class="TodoSpirits.Windows.Views.TaskPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
             xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels"
             IsVisibleChanged="OnVisibleChanged">
    <!-- 일정 추가 · 상세 패널. 시안 scripts/task-form.js + app.css 의 .panel / .fcard / .tf-* 와 같은 구조 -->
    <UserControl.Resources>
        <Style x:Key="RowIcon" TargetType="v:Icon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Line" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Stroke}"/>
        </Style>

        <!-- 행 오른쪽의 값 버튼 (.tf-val): 누르면 아래가 펼쳐지거나 메뉴가 뜬다. Tag = 뒤에 붙는 아이콘 -->
        <Style x:Key="Val" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <v:Icon x:Name="ic" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="14" Height="14" Margin="2,0,0,0" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="ic" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Back02}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 드롭다운 메뉴의 한 줄 (.tf-menu button): 고른 값은 분홍 굵은 글자 -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Content" Value="{Binding}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource MenuHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RepeatOption">
            <Button x:Name="o" Style="{StaticResource MenuRow}" Command="{Binding DataContext.PickRepeatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SameText}">
                            <Binding/>
                            <Binding Path="DataContext.EditRepeat" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="o" Property="Foreground" Value="{DynamicResource PinkB}"/>
                    <Setter TargetName="o" Property="FontWeight" Value="ExtraBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="AlarmOption">
            <Button x:Name="o" Style="{StaticResource MenuRow}" Command="{Binding DataContext.PickAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SameText}">
                            <Binding/>
                            <Binding Path="DataContext.EditAlarm" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="o" Property="Foreground" Value="{DynamicResource PinkB}"/>
                    <Setter TargetName="o" Property="FontWeight" Value="ExtraBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 메뉴 상자 (.tf-menu) -->
        <Style x:Key="MenuBox" TargetType="Border">
            <Setter Property="Margin" Value="14,6,14,26"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Background" Value="{DynamicResource Elev}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ElevRing}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0,4,0,3"/>
            <Setter Property="Effect" Value="{DynamicResource FloatShadow}"/>
        </Style>

        <!-- 중요: 분홍 체크 상자 (.box) -->
        <Style x:Key="PinkBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="b" Width="24" Height="24" CornerRadius="8" BorderBrush="{DynamicResource CheckB}" BorderThickness="2" Background="Transparent">
                            <v:Icon x:Name="c" Data="{StaticResource IcCheck}" Width="14" Height="14" Thickness="2.8" Foreground="{DynamicResource OnPink}" Opacity="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Pink}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Pink}"/>
                                <Setter TargetName="c" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 휠의 앞뒤 값 (.tf-wheel button): 흐리게 보이고, 누르면 그쪽으로 넘어간다 -->
        <Style x:Key="WheelSide" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Grey}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WheelNow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 매주: 요일 칸 (.tf-chip). 고르면 테두리와 글자만 짙어진다 -->
        <DataTemplate x:Key="WeekChip" DataType="{x:Type vm:DayChip}">
            <Button Cursor="Hand" Margin="3,0" Height="38" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Label}"
                    Command="{Binding DataContext.ToggleRepeatDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
                            <TextBlock x:Name="t" Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource Grey}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Text2}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="ExtraBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- 달력의 하루 (.tf-d): 32px 원. 오늘은 안쪽 테두리, 고른 날은 갈색 채움 -->
        <ControlTemplate x:Key="DayDot" TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="16" Width="32" Height="32" BorderThickness="1.5" BorderBrush="{TemplateBinding BorderBrush}">
                <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Back02}"/>
                </Trigger>
                <Trigger Property="v:Ui.Selected" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Text}"/>
                    <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                    <Setter TargetName="t" Property="Foreground" Value="{DynamicResource OnText}"/>
                    <Setter TargetName="t" Property="FontWeight" Value="ExtraBold"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <DataTemplate x:Key="MiniDay" DataType="{x:Type vm:MiniDay}">
            <Button x:Name="d" Cursor="Hand" Margin="0,1" BorderBrush="Transparent" Content="{Binding Num}" Template="{StaticResource DayDot}" v:Ui.Selected="{Binding IsSelected}"
                    FocusVisualStyle="{StaticResource FocusRing}"
                    Command="{Binding DataContext.PickEditDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOther}" Value="True">
                    <Setter TargetName="d" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="d" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="MonthPick" DataType="{x:Type vm:DayChip}">
            <Button x:Name="d" Cursor="Hand" Margin="0,1" BorderBrush="Transparent" Content="{Binding Label}" Template="{StaticResource DayDot}" v:Ui.Selected="{Binding IsOn}"
                    FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Label}"
                    Command="{Binding DataContext.ToggleRepeatDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBlank}" Value="True">
                    <Setter TargetName="d" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="Dow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style x:Key="CalNav" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="v:Ui.Radius" Value="14"/>
            <Setter Property="v:Ui.IconSize" Value="16"/>
        </Style>

        <!-- 아래 버튼 (.pbtn): 아이콘 위, 글자 아래 -->
        <Style x:Key="PBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Effect="{DynamicResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <v:Icon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="21" Height="21" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Back02}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PBtnDel" TargetType="Button" BasedOn="{StaticResource PBtn}">
            <Setter Property="Foreground" Value="{DynamicResource Del}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DelBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="14,0">
                <TextBlock Text="{Binding PanelTitle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconBtn}" Tag="{StaticResource IcX}" HorizontalAlignment="Right" ToolTip="닫기 (Esc)" AutomationProperties.Name="패널 닫기"
                        Command="{Binding ClosePanelCommand}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditSettings}">
                <StackPanel x:Name="Body" Margin="22,4,22,20">
                    <!-- 제목: 밑줄만 있는 입력칸. 초점이 오면 밑줄이 라임색 -->
                    <Grid Margin="0,0,0,22">
                        <TextBox x:Name="TitleBox" AutomationProperties.Name="일정 제목" FontSize="19" FontWeight="Bold" Height="Auto"
                                 Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnTitleKeyDown">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="b" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,2" Padding="2,8,2,12" Background="Transparent">
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Lime}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <TextBlock Text="일정 입력" FontSize="19" Foreground="{DynamicResource Grey}" Margin="6,8,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 중요 -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <Grid MinHeight="54" Margin="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <v:Icon Data="{StaticResource IcStar}" Style="{StaticResource RowIcon}"/>
                                <TextBlock Text="중요" Style="{StaticResource RowLabel}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource PinkBox}" AutomationProperties.Name="중요" IsChecked="{Binding EditImportant}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- 날짜 · 시간 · 반복 · 알림 -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <!-- 날짜 -->
                            <Border CornerRadius="17,17,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditCalOpen}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Back02}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid MinHeight="54" Margin="16,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <v:Icon Data="{StaticResource IcCal}" Style="{StaticResource RowIcon}"/>
                                        <TextBlock Text="{Binding EditDateLabel}" Style="{StaticResource RowLabel}"/>
                                    </StackPanel>
                                    <Button Content="{Binding EditDateText}" Style="{StaticResource Val}" ToolTip="달력 펼치기 / 접기" AutomationProperties.Name="날짜 고르기"
                                            Command="{Binding ToggleEditCalCommand}"/>
                                </Grid>
                            </Border>
                            <StackPanel Visibility="{Binding EditCalOpen, Converter={StaticResource BoolVis}}" v:Motion.Enter="Up">
                                <Border Style="{StaticResource Line}"/>
                                <StackPanel Margin="14,10,14,14">
                                    <Grid Margin="2,0,2,6">
                                        <TextBlock Text="{Binding EditCalTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource CalNav}" Tag="{StaticResource IcChevLeft}" ToolTip="이전 달" AutomationProperties.Name="이전 달" Command="{Binding EditCalPrevCommand}"/>
                                            <Button Style="{StaticResource CalNav}" Tag="{StaticResource IcChevRight}" ToolTip="다음 달" AutomationProperties.Name="다음 달" Command="{Binding EditCalNextCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Columns="7">
                                        <TextBlock Text="SUN" Style="{StaticResource Dow}"/>
                                        <TextBlock Text="MON" Style="{StaticResource Dow}"/>
                                        <TextBlock Text="TUE" Style="{StaticResource Dow}"/>
                                        <TextBlock Text="WED" Style="{StaticResource Dow}"/>
                                        <TextBlock Text="THU" Style="{StaticResource Dow}"/>
                                        <TextBlock Text="FRI" Style="{StaticResource Dow}"/>
                                        <TextBlock Text="SAT" Style="{StaticResource Dow}"/>
                                    </UniformGrid>
                                    <ItemsControl ItemsSource="{Binding EditCalCells}" ItemTemplate="{StaticResource MiniDay}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- 시간 -->
                            <Border Style="{StaticResource Line}"/>
                            <Grid MinHeight="54" Margin="16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcClock}" Style="{StaticResource RowIcon}"/>
                                    <TextBlock Text="시간" Style="{StaticResource RowLabel}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="{Binding EditTimeText}" Style="{StaticResource Val}" Foreground="{DynamicResource Text2}" Margin="0,0,8,0"
                                            ToolTip="시간 고르기 펼치기 / 접기" AutomationProperties.Name="시간 고르기"
                                            Command="{Binding ToggleEditSectionCommand}" CommandParameter="time"
                                            Visibility="{Binding EditHasTime, Converter={StaticResource BoolVis}}"/>
                                    <CheckBox Style="{StaticResource Switch}" AutomationProperties.Name="시간 정하기" IsChecked="{Binding EditHasTime}"/>
                                </StackPanel>
                            </Grid>
                            <!-- 시간 휠: 가운데 띠가 고른 값. 마우스 휠 · 위아래 값 누르기 · 방향키. 분은 5분씩 -->
                            <StackPanel Visibility="{Binding EditTimeOpen, Converter={StaticResource BoolVis}}" v:Motion.Enter="Up">
                                <Border Style="{StaticResource Line}"/>
                                <Grid Margin="14,6,14,10">
                                    <Border Background="{DynamicResource Back02}" CornerRadius="12" Height="42" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EditAmPm}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel x:Name="HourWheel" Background="Transparent" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="시"
                                                    MouseWheel="OnHourWheel" KeyDown="OnHourKey" MouseLeftButtonDown="OnWheelClick" ToolTip="마우스 휠이나 방향키로도 바꿀 수 있어요">
                                            <Button Style="{StaticResource WheelSide}" Content="{Binding EditHourPrev}" AutomationProperties.Name="시 내리기" Command="{Binding HourDownCommand}"/>
                                            <Grid Height="42"><TextBlock Text="{Binding EditHour12}" Style="{StaticResource WheelNow}"/></Grid>
                                            <Button Style="{StaticResource WheelSide}" Content="{Binding EditHourNext}" AutomationProperties.Name="시 올리기" Command="{Binding HourUpCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text=":" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="6,0,6,3"/>
                                        <StackPanel x:Name="MinuteWheel" Background="Transparent" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="분"
                                                    MouseWheel="OnMinuteWheel" KeyDown="OnMinuteKey" MouseLeftButtonDown="OnWheelClick" ToolTip="마우스 휠이나 방향키로도 바꿀 수 있어요">
                                            <Button Style="{StaticResource WheelSide}" Content="{Binding EditMinutePrev}" AutomationProperties.Name="분 내리기" Command="{Binding MinuteDownCommand}"/>
                                            <Grid Height="42"><TextBlock Text="{Binding EditMinuteText}" Style="{StaticResource WheelNow}"/></Grid>
                                            <Button Style="{StaticResource WheelSide}" Content="{Binding EditMinuteNext}" AutomationProperties.Name="분 올리기" Command="{Binding MinuteUpCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 반복 -->
                            <Border Style="{StaticResource Line}"/>
                            <Grid MinHeight="54" Margin="16,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcRepeat}" Style="{StaticResource RowIcon}"/>
                                    <TextBlock Text="반복" Style="{StaticResource RowLabel}"/>
                                </StackPanel>
                                <Button x:Name="RepeatBtn" Content="{Binding EditRepeatSummary}" Tag="{StaticResource IcUpDown}" MaxWidth="230" AutomationProperties.Name="반복"
                                        Command="{Binding ToggleEditSectionCommand}" CommandParameter="repeat">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Val}">
                                            <Style.Triggers>
                                                <!-- 메뉴가 떠 있을 때 버튼을 다시 누르면 닫히기만 하게 한다 -->
                                                <DataTrigger Binding="{Binding RepeatMenuOpen}" Value="True">
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Popup IsOpen="{Binding RepeatMenuOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=RepeatBtn}"
                                       Placement="Bottom" HorizontalOffset="-14" PopupAnimation="Fade">
                                    <Border Style="{StaticResource MenuBox}">
                                        <ItemsControl ItemsSource="{Binding RepeatOptions}" ItemTemplate="{StaticResource RepeatOption}" Focusable="False"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <StackPanel Visibility="{Binding EditIsWeekly, Converter={StaticResource BoolVis}}" v:Motion.Enter="Up">
                                <Border Style="{StaticResource Line}"/>
                                <ItemsControl ItemsSource="{Binding WeekdayChips}" ItemTemplate="{StaticResource WeekChip}" Margin="11,10,11,14" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Visibility="{Binding EditIsMonthly, Converter={StaticResource BoolVis}}" v:Motion.Enter="Up">
                                <Border Style="{StaticResource Line}"/>
                                <StackPanel Margin="14,10,14,14">
                                    <ItemsControl ItemsSource="{Binding MonthDayChips}" ItemTemplate="{StaticResource MonthPick}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="매월 반복할 날짜를 골라요" FontSize="12" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 알림 -->
                            <Border Style="{StaticResource Line}"/>
                            <Grid MinHeight="54" Margin="16,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <v:Icon Data="{StaticResource IcBell}" Style="{StaticResource RowIcon}"/>
                                    <TextBlock Text="알림" Style="{StaticResource RowLabel}"/>
                                </StackPanel>
                                <TextBlock Text="시간을 정하면 받을 수 있어요" FontSize="12" Foreground="{DynamicResource Grey}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding EditHasTime, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>
                                <Button x:Name="AlarmBtn" Content="{Binding EditAlarm}" Tag="{StaticResource IcUpDown}" AutomationProperties.Name="알림"
                                        Command="{Binding ToggleEditSectionCommand}" CommandParameter="alarm"
                                        Visibility="{Binding EditHasTime, Converter={StaticResource BoolVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Val}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmMenuOpen}" Value="True">
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Popup IsOpen="{Binding AlarmMenuOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=AlarmBtn}"
                                       Placement="Bottom" HorizontalOffset="-14" PopupAnimation="Fade">
                                    <Border Style="{StaticResource MenuBox}">
                                        <ItemsControl ItemsSource="{Binding AlarmOptions}" ItemTemplate="{StaticResource AlarmOption}" Focusable="False"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding TaskEditHelp}" FontSize="12" Foreground="{DynamicResource Text2}" Margin="6,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsExisting, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="반복 일정은 완료가 날짜마다 따로 기록돼요. 삭제하면 모든 날짜에서 사라져요." FontSize="12" Foreground="{DynamicResource Text2}" Margin="6,6,0,0"
                               TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding EditIsRepeating, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <Button Style="{StaticResource Primary}" Content="{Binding TaskSaveLabel}" Margin="22,14,22,0" Command="{Binding SaveCommand}"
                        Visibility="{Binding ShowTaskSave, Converter={StaticResource BoolVis}}"/>
                <UniformGrid Columns="2" Margin="17,14,17,0" Visibility="{Binding IsExisting, Converter={StaticResource BoolVis}}">
                    <Button Style="{StaticResource PBtnDel}" Content="삭제" Tag="{StaticResource IcTrash}" Margin="5,0" AutomationProperties.Name="삭제" Command="{Binding DeleteCommand}"/>
                    <Button Style="{StaticResource PBtn}" Content="{Binding EditDoneLabel}" Tag="{StaticResource IcCheck}" Margin="5,0" AutomationProperties.Name="{Binding EditDoneLabel}" Command="{Binding ToggleEditingCommand}"/>
                </UniformGrid>
                <Border Height="22"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
