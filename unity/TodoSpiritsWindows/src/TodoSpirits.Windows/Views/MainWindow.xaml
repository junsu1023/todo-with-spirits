<Window x:Class="TodoSpirits.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
        Title="Todo with Spirits" Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Back01}"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClosePanelCommand}"/>
    </Window.InputBindings>

    <Border x:Name="Root" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목 표시줄 -->
            <Grid Background="{DynamicResource Back01}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/spirit_neutral.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Todo with Spirits" FontSize="12" Foreground="{DynamicResource Text2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Flat}" Content="{Binding ThemeLabel}" FontSize="12" Padding="10,4" Margin="0,3,8,3"
                            Foreground="{DynamicResource Text2}" Command="{Binding ToggleThemeCommand}" ToolTip="테마 바꾸기"/>
                    <Button Style="{StaticResource Flat}" Content="—" Width="44" Padding="0" HorizontalContentAlignment="Center" ToolTip="최소화" Click="OnMinimize"/>
                    <Button Style="{StaticResource Flat}" Content="☐" Width="44" Padding="0" HorizontalContentAlignment="Center" ToolTip="최대화" Click="OnMaximize"/>
                    <Button Style="{StaticResource Flat}" Content="✕" Width="44" Padding="0" HorizontalContentAlignment="Center" ToolTip="닫기" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 사이드바 -->
                <DockPanel Background="{DynamicResource Back01}" Margin="12,8,8,14">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="설정" Tag="settings" Command="{Binding NavigateCommand}" CommandParameter="settings">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="settings">
                                            <Setter Property="Background" Value="{DynamicResource Card}"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <Button Content="홈" Command="{Binding NavigateCommand}" CommandParameter="home">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="home">
                                            <Setter Property="Background" Value="{DynamicResource Card}"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="캘린더" Command="{Binding NavigateCommand}" CommandParameter="calendar">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="calendar">
                                            <Setter Property="Background" Value="{DynamicResource Card}"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="정령 도감" Command="{Binding NavigateCommand}" CommandParameter="dex">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="dex">
                                            <Setter Property="Background" Value="{DynamicResource Card}"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="정령의 숲  · 출시 예정" Command="{Binding NavigateCommand}" CommandParameter="forest">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                                    <Setter Property="Foreground" Value="{DynamicResource Grey}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="forest">
                                            <Setter Property="Background" Value="{DynamicResource Card}"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- 화면 -->
                <Grid Grid.Column="1" Margin="14,0,26,0">
                    <v:HomeView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=home}"/>
                    <v:CalendarView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=calendar}"/>
                    <v:DexView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=dex}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=forest}">
                        <TextBlock Text="정령의 숲이 곧 열려요" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="정령들이 사는 숲을 준비하고 있어요." Foreground="{DynamicResource Text2}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <v:SettingsView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=settings}"/>
                </Grid>

                <!-- 일정 추가·상세 패널 -->
                <v:TaskPanel Grid.Column="2" Width="384" Visibility="{Binding PanelOpen, Converter={StaticResource BoolVis}}"/>

                <!-- 토스트 -->
                <Border Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Padding="18,10,10,10" CornerRadius="22"
                        Background="{DynamicResource Elev}" BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1"
                        Visibility="{Binding ToastOpen, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.14" Color="#5A4632"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ToastText}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="되돌리기" Style="{StaticResource Pill}" Command="{Binding UndoCommand}"
                                Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
