<Window x:Class="TodoSpirits.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
        Title="Todo with Spirits" Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Back01}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource AppFont}" FontSize="15" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <!-- 글자 키(? W M Y), Space, Delete, 방향키는 입력 칸과 겹치지 않게 코드(OnPreviewKeyDown)에서 처리한다 -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleNavCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenSearchCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ToggleHelpCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClosePanelCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- 사이드바 버튼 (.navbtn): CommandParameter(화면 이름)가 지금 화면과 같으면 선택 표시 -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Command" Value="{Binding NavigateCommand}"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14" Padding="14,0">
                            <DockPanel VerticalAlignment="Center">
                                <v:Icon x:Name="ic" DockPanel.Dock="Left" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="20" Height="20" Margin="0,0,12,0"
                                        Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Back02}"/>
                            </Trigger>
                            <Trigger Property="v:Ui.Selected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                                <Setter TargetName="b" Property="Effect" Value="{DynamicResource CardShadow}"/>
                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource LimeT}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource SameText}">
                            <Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="Page"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="v:Ui.Selected" Value="True"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 제목 표시줄 왼쪽의 작은 버튼 (.tb-btn) -->
        <Style x:Key="TbBtn" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="v:Ui.Radius" Value="8"/>
            <Setter Property="v:Ui.IconSize" Value="17"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 단축키 안내의 키 하나 (kbd) -->
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Back02}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="7,3,7,1"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="KbdText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목 표시줄 -->
            <Grid Background="{DynamicResource Back01}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource TbBtn}" Tag="{StaticResource IcMenu}" ToolTip="사이드바 잠깐 보기" AutomationProperties.Name="메뉴" Margin="0,0,2,0"
                            Command="{Binding NavMenuCommand}"/>
                    <Button Style="{StaticResource TbBtn}" Tag="{StaticResource IcSide}" ToolTip="{Binding NavTip}" AutomationProperties.Name="사이드바"
                            Command="{Binding ToggleNavCommand}"/>
                    <Image Source="/Assets/spirit_neutral.png" Width="16" Height="16" Margin="8,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Todo with Spirits" FontSize="12" Foreground="{DynamicResource Text2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button ToolTip="{Binding ThemeLabel}" Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="{Binding ThemeLabel}" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TbBtn}">
                                <Setter Property="Tag" Value="{StaticResource IcMoon}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDark}" Value="True">
                                        <Setter Property="Tag" Value="{StaticResource IcSun}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource TitleCtl}" Tag="{StaticResource IcMin}" ToolTip="최소화" AutomationProperties.Name="최소화" Click="OnMinimize"/>
                    <Button Style="{StaticResource TitleCtl}" Tag="{StaticResource IcMax}" ToolTip="최대화" AutomationProperties.Name="최대화" Click="OnMaximize"/>
                    <Button Style="{StaticResource TitleClose}" Tag="{StaticResource IcX}" ToolTip="닫기" AutomationProperties.Name="닫기" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <!-- 본문: [사이드바 자리] [화면] [오른쪽 패널 자리]. 사이드바와 패널은 그 위에 따로 얹어, 자리 너비와 밀려 나오는 움직임을 코드에서 맞춘다 -->
            <Grid x:Name="Shell" Grid.Row="1" ClipToBounds="True" PreviewMouseDown="OnShellMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="NavSpace" Width="212"/>
                <Border x:Name="PanelSpace" Grid.Column="2" Width="0"/>

                <!-- 화면 -->
                <Grid x:Name="Main" Grid.Column="1" Margin="14,0,28,0">
                    <v:HomeView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=home}"/>
                    <v:CalendarView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=calendar}"/>
                    <v:DexView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=dex}" v:Motion.Enter="Up"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" v:Motion.Enter="Up"
                                Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=forest}">
                        <Image Source="/Assets/spirit_neutral.png" Width="120" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border Style="{StaticResource LimeTag}" HorizontalAlignment="Center" Margin="0,14,0,10">
                            <TextBlock Text="출시 예정" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}"/>
                        </Border>
                        <TextBlock Text="정령의 숲이 곧 열려요" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="정령들이 사는 숲을 준비하고 있어요." Foreground="{DynamicResource Text2}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <v:SettingsView Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=settings}" v:Motion.Enter="Up"/>
                </Grid>

                <!-- 오른쪽 패널: 월간의 날짜 목록, 또는 일정 추가 · 상세. 좁은 창에서는 내용 위에 겹쳐 뜬다 -->
                <Border x:Name="RightHost" Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="384" Panel.ZIndex="34" Visibility="Collapsed" Background="{DynamicResource PanelBg}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="RightShift"/>
                    </Border.RenderTransform>
                    <Grid>
                        <v:DayPanel Visibility="{Binding DayListVisible, Converter={StaticResource BoolVis}}"/>
                        <v:TaskPanel Visibility="{Binding PanelOpen, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                </Border>

                <!-- 숨긴 사이드바: 왼쪽 가장자리에 마우스를 올리면 잠깐 나온다 -->
                <Border x:Name="NavEdge" Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="12" Background="Transparent" Panel.ZIndex="35" MouseEnter="OnNavEdgeEnter"
                        Visibility="{Binding NavPinned, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>
                <!-- 사이드바 -->
                <Border x:Name="NavHost" Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="212" Panel.ZIndex="36" Background="{DynamicResource Back01}"
                        MouseEnter="OnNavEnter" MouseLeave="OnNavLeave">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavShift"/>
                    </Border.RenderTransform>
                    <DockPanel Margin="14,10,14,18">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Content="설정" Tag="{StaticResource IcGear}" CommandParameter="settings" AutomationProperties.Name="설정" Style="{StaticResource NavItem}"/>
                            <!-- 프로필 위의 점선 -->
                            <Rectangle Height="1" Stroke="{DynamicResource Stroke}" StrokeThickness="1" StrokeDashArray="4 3" Margin="0,8,0,0" SnapsToDevicePixels="True"/>
                            <StackPanel Orientation="Horizontal" Margin="12,14,12,4">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PinkOp}">
                                    <TextBlock Text="{Binding AvatarText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PinkB}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding ProfileName}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <Button Content="홈" Tag="{StaticResource IcHome}" CommandParameter="home" AutomationProperties.Name="홈" Style="{StaticResource NavItem}"/>
                            <Button Content="캘린더" Tag="{StaticResource IcCal}" CommandParameter="calendar" AutomationProperties.Name="캘린더" Style="{StaticResource NavItem}"/>
                            <Button Content="정령 도감" Tag="{StaticResource IcCards}" CommandParameter="dex" AutomationProperties.Name="정령 도감" Style="{StaticResource NavItem}"/>
                            <Button Tag="{StaticResource IcTree}" CommandParameter="forest" AutomationProperties.Name="정령의 숲" Foreground="{DynamicResource Grey}" Style="{StaticResource NavItem}">
                                <DockPanel Width="140">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Back02}" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="출시 예정" FontSize="9.5" FontWeight="ExtraBold" Foreground="{DynamicResource Text2}"/>
                                    </Border>
                                    <TextBlock Text="정령의 숲" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 알림: 내용 위에 겹쳐 뜨는 플라이아웃. 바깥(옅은 가림막)을 누르면 닫힌다 -->
                <Border x:Name="NotiScrim" Grid.ColumnSpan="3" Background="{DynamicResource ScrimSoft}" Panel.ZIndex="40" Visibility="Collapsed" MouseLeftButtonDown="OnNotiScrimDown"/>
                <Border x:Name="NotiHost" Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="400" Panel.ZIndex="41" Visibility="Collapsed" Effect="{DynamicResource SideShadow}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NotiShift"/>
                    </Border.RenderTransform>
                    <v:NotiPanel/>
                </Border>

                <!-- 단축키 안내: 뒤를 가리고 가운데에 띄운다 -->
                <Grid Grid.ColumnSpan="3" Panel.ZIndex="50" Visibility="{Binding HelpOpen, Converter={StaticResource BoolVis}}" v:Motion.Enter="Fade">
                    <Border Background="{DynamicResource Scrim}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleHelpCommand}"/>
                        </Border.InputBindings>
                    </Border>
                    <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="24" Padding="26,24,26,24"
                            Background="{DynamicResource Elev}" BorderBrush="{DynamicResource ElevRing}" BorderThickness="1" Effect="{DynamicResource ModalShadow}" v:Motion.Enter="Pop">
                        <StackPanel>
                            <TextBlock Text="단축키" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl" Style="{StaticResource KbdText}"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="N" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="일정 추가" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl" Style="{StaticResource KbdText}"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="F" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="검색" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl" Style="{StaticResource KbdText}"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="B" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="사이드바 고정 / 숨기기" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="Space" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="고른 일정 완료" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="Enter" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="고른 일정 자세히 보기" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="Delete" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="고른 일정 삭제" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="W" Style="{StaticResource KbdText}"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="M" Style="{StaticResource KbdText}"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="Y" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="캘린더 주간 / 월간 / 연간" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="PgUp" Style="{StaticResource KbdText}"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="PgDn" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="캘린더 이전 / 다음" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="Esc" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="패널 · 메뉴 닫기" Style="{StaticResource KeyLabel}"/></Grid>
                            <Grid Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource Kbd}"><TextBlock Text="?" Style="{StaticResource KbdText}"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="F1" Style="{StaticResource KbdText}"/></Border></StackPanel><TextBlock Text="이 안내 열기" Style="{StaticResource KeyLabel}"/></Grid>
                            <Button Style="{StaticResource Primary}" Content="확인" Height="46" FontSize="15" Margin="0,14,0,0" AutomationProperties.Name="단축키 닫기" Command="{Binding ToggleHelpCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 토스트 (.toast): 알약, 왼쪽에 떠 있는 정령 -->
                <Border x:Name="Toast" Grid.ColumnSpan="3" Panel.ZIndex="60" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="6,6,16,6" CornerRadius="23"
                        Background="{DynamicResource Elev}" BorderBrush="{DynamicResource ElevRing}" BorderThickness="1" Effect="{DynamicResource FloatShadow}"
                        Visibility="{Binding ToastOpen, Converter={StaticResource BoolVis}}" v:Motion.Enter="Toast">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PinkOp}" Margin="0,0,10,0">
                            <Image x:Name="ToastSpirit" Source="/Assets/spirit_neutral.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <TranslateTransform/>
                                </Image.RenderTransform>
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="1.5" To="-2.5" Duration="0:0:0.8">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>
                        <TextBlock Text="{Binding ToastText}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="520"/>
                        <Button Content="되돌리기" Style="{StaticResource Flat}" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}" Padding="10,4" Margin="8,0,-8,0" v:Ui.Radius="12"
                                Command="{Binding UndoCommand}" Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
