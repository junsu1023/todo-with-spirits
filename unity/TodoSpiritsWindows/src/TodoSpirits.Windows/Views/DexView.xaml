<UserControl x:Class="TodoSpirits.Windows.Views.DexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
             xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels">
    <!-- 정령 도감 — 시안 unity/windows-ui/design/dex-v4.html -->
    <UserControl.Resources>
        <v:DexRatio x:Key="Ratio"/>

        <!-- 시안에만 있는 고정 색 (테마 사전에 없는 값) -->
        <SolidColorBrush x:Key="HeartOn" Color="#FF96DE"/>
        <SolidColorBrush x:Key="HeartOnB" Color="#F168C6"/>
        <SolidColorBrush x:Key="DarkDash" Color="#5A5046"/>
        <SolidColorBrush x:Key="DarkSelRing" Color="#4DB9A895"/>
        <SolidColorBrush x:Key="DarkHeroBase" Color="#EFE7DE"/>
        <SolidColorBrush x:Key="DarkHeroGlow" Color="#FFF6FB"/>
        <SolidColorBrush x:Key="DarkHintGlow" Color="#2F2A25"/>
        <DropShadowEffect x:Key="RepShadow" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.4" Color="#C1DD00"/>
        <DropShadowEffect x:Key="BadgeShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#5A4632"/>

        <!-- 가운데가 밝은 둥근 빛: 색 대신 투명도로 만들어 테마 색을 그대로 쓴다 (radial-gradient 60% 55% at 50% 55%) -->
        <RadialGradientBrush x:Key="GlowMask" Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.6" RadiusY="0.55">
            <GradientStop Color="#FF000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="0.75"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowMaskDark" Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.6" RadiusY="0.55">
            <GradientStop Color="#FF000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="0.8"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="RampMask" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#FF000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- 두 색이 이어지는 진행 막대: Foreground = 시작 색, BorderBrush = 끝 색 -->
        <Style x:Key="GradBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource Track}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                                <Border Background="{TemplateBinding BorderBrush}" CornerRadius="4" OpacityMask="{StaticResource RampMask}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 하트 5개: 채워진 것은 핑크, 빈 것은 흐린 색 -->
        <DataTemplate x:Key="Heart">
            <Path x:Name="h" Data="{StaticResource IcHeart}" Stretch="Uniform" Width="14" Height="14" Margin="1,0"
                  Fill="{DynamicResource HeartOff}" Stroke="{DynamicResource HeartOff}" StrokeThickness="0.8" StrokeLineJoin="Round"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter TargetName="h" Property="Fill" Value="{StaticResource HeartOn}"/>
                    <Setter TargetName="h" Property="Stroke" Value="{StaticResource HeartOnB}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="HeartBig">
            <Path x:Name="h" Data="{StaticResource IcHeart}" Stretch="Uniform" Width="20" Height="20" Margin="1,0"
                  Fill="{DynamicResource HeartOff}" Stroke="{DynamicResource HeartOff}" StrokeThickness="1" StrokeLineJoin="Round"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter TargetName="h" Property="Fill" Value="{StaticResource HeartOn}"/>
                    <Setter TargetName="h" Property="Stroke" Value="{StaticResource HeartOnB}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Row">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <!-- 칸 수는 목록 너비에 따라 4 → 3 → 2 (코드에서 정한다) -->
        <ItemsPanelTemplate x:Key="CardGrid">
            <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type v:DexView}}}" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>

        <!-- 키보드 초점: 그림 칸(정사각형) 둘레에만 -->
        <Style x:Key="CardFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border VerticalAlignment="Top" Margin="-3" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                BorderBrush="{DynamicResource Focus}" BorderThickness="3" CornerRadius="21"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 도감 한 칸: 정사각형 그림 칸 + 이름 + 하트 -->
        <Style x:Key="SpiritCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,6,14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Background="Transparent">
                            <Grid x:Name="lift" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                                <Border x:Name="ring" Margin="-4" CornerRadius="22" Background="{DynamicResource SelRing}" Visibility="Collapsed"/>
                                <Border x:Name="sh" CornerRadius="18" Background="{DynamicResource Frame}" Effect="{DynamicResource CardShadow}"/>
                                <Border x:Name="frame" CornerRadius="18" Background="{DynamicResource Frame}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"/>
                                <!-- 아직 못 만난 정령: 점선 테두리, 그림자 없음 -->
                                <Rectangle x:Name="dash" RadiusX="18" RadiusY="18" Fill="{DynamicResource PanelBg}" Stroke="{DynamicResource CarryB}" StrokeThickness="1"
                                           StrokeDashArray="4 3" SnapsToDevicePixels="True" Visibility="Collapsed"/>
                                <Image x:Name="art" Source="{Binding Art}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Width="{Binding ActualWidth, ElementName=lift, Converter={StaticResource Ratio}, ConverterParameter=0.78}"
                                       Height="{Binding ActualWidth, ElementName=lift, Converter={StaticResource Ratio}, ConverterParameter=0.78}"
                                       RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Grid x:Name="rep" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" ToolTip="대표 정령"
                                      Visibility="{Binding IsRepresentative, Converter={StaticResource BoolVis}}">
                                    <Ellipse Fill="{DynamicResource Lime}" Effect="{StaticResource RepShadow}"/>
                                    <v:Icon Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="15" Height="15" Foreground="{DynamicResource OnLime}"/>
                                </Grid>
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Visibility="{Binding HasElement, Converter={StaticResource BoolVis}}">
                                    <Border Background="{DynamicResource Card}" CornerRadius="9" Effect="{StaticResource BadgeShadow}"/>
                                    <StackPanel Orientation="Horizontal" Margin="5,2,7,2">
                                        <Ellipse Width="8" Height="8" Fill="{Binding ElementBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Element}" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource Text}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="nm" Text="{Binding Name}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <ItemsControl ItemsSource="{Binding Hearts}" ItemTemplate="{StaticResource Heart}" ItemsPanel="{StaticResource Row}" HorizontalAlignment="Center" Focusable="False"
                                          Margin="0,8,0,0" ToolTip="{Binding HeartsTip}" Visibility="{Binding Owned, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsDark, RelativeSource={RelativeSource AncestorType={x:Type v:DexView}}}" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                <Setter TargetName="art" Property="Source" Value="{Binding ArtDark}"/>
                                <Setter TargetName="dash" Property="Stroke" Value="{StaticResource DarkDash}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Owned}" Value="False">
                                <Setter TargetName="frame" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="sh" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource Grey}"/>
                                <Setter TargetName="art" Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Owned}" Value="False"/>
                                    <Condition Binding="{Binding DataContext.IsDark, RelativeSource={RelativeSource AncestorType={x:Type v:DexView}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="art" Property="Opacity" Value="0.85"/>
                            </MultiDataTrigger>
                            <!-- 마우스를 올리면 그림자가 짙어진다 (떠오름과 그림 흔들림은 코드에서) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sh" Property="Effect" Value="{DynamicResource LiftShadow}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource SelB}"/>
                                <Setter TargetName="dash" Property="Stroke" Value="{DynamicResource SelB}"/>
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="sh" Property="Effect" Value="{x:Null}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.IsDark, RelativeSource={RelativeSource AncestorType={x:Type v:DexView}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                                <Setter TargetName="dash" Property="Stroke" Value="{DynamicResource Text2}"/>
                                <Setter TargetName="ring" Property="Margin" Value="-3"/>
                                <Setter TargetName="ring" Property="CornerRadius" Value="21"/>
                                <Setter TargetName="ring" Property="Background" Value="{StaticResource DarkSelRing}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SpiritCell" DataType="{x:Type vm:SpiritRow}">
            <Button Style="{StaticResource SpiritCard}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}"
                    Click="OnCardClick" MouseDoubleClick="OnCardDoubleClick" MouseEnter="OnCardEnter" MouseLeave="OnCardLeave"/>
        </DataTemplate>

        <!-- 전체 / 카테고리별: 마우스를 올리면 글자색만 바뀐다 -->
        <Style x:Key="Seg" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="v:Ui.Radius" Value="18"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 미보유만: 네모 체크 (20×20, 켜면 글자색 바탕) -->
        <Style x:Key="DexCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource CheckB}" Background="Transparent" VerticalAlignment="Center">
                                <v:Icon x:Name="mark" Data="{StaticResource IcCheck}" Thickness="2.8" Width="12" Height="12" Foreground="{DynamicResource OnText}" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Text}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Text}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 정렬 고르는 단추: 바탕 없이 글자와 작은 화살표 -->
        <Style x:Key="SortButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent" Height="28">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <v:Icon Data="{StaticResource IcChevDown}" Thickness="2" Width="14" Height="14" Margin="4,1,0,0" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 정렬 메뉴의 한 줄 (시안 .tf-menu button) -->
        <DataTemplate x:Key="SortItem" DataType="{x:Type vm:DexSortOption}">
            <Button Click="OnSortPick" Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Label}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Height="36" Padding="14,0">
                            <TextBlock x:Name="t" Text="{Binding Label}" FontSize="14" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                <Setter TargetName="b" Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource MenuHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource MenuHover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="t" Property="Foreground" Value="{DynamicResource PinkB}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="ExtraBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- 패널의 정보 표 한 줄 -->
        <Style x:Key="InfoKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- 패널은 창 너비에 따라 384 / 340 / 320: 오른쪽 여백만큼 밖으로 나가므로 칸 너비는 그만큼 작다 (코드에서 정한다) -->
            <ColumnDefinition x:Name="PanelCol" Width="358"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftArea" Margin="0,0,22,0" SizeChanged="OnLeftSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 머리: 제목 · 알림 -->
            <Grid>
                <TextBlock Text="정령 도감" FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="2,0,0,0"/>
                <v:BellButton HorizontalAlignment="Right"/>
            </Grid>

            <!-- 요약: 대표 정령 · 만난 정령. (정령 규칙이 아직 예시라는 안내는 이 카드의 말풍선으로) -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,14" ToolTip="{Binding DexNote}" ToolTipService.InitialShowDelay="600">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource PinkOp}">
                        <Image Source="{Binding Representative.Art}" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="대표 정령" FontSize="12" Foreground="{DynamicResource Text2}"/>
                        <TextBlock Text="{Binding Representative.Name}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="220">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="만난 정령" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding SpiritsProgress}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource GradBar}" Maximum="{Binding SpiritsTotal, Mode=OneWay}" Value="{Binding SpiritsOwned, Mode=OneWay}"
                                     Foreground="{DynamicResource Pink}" BorderBrush="{DynamicResource Lime}" AutomationProperties.Name="만난 정령"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 보기 방식: 전체 / 카테고리별 · 미보유만 · 정렬 -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Border Background="{DynamicResource Back02}" CornerRadius="23" Padding="5" Width="260" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="전체" CommandParameter="all" Click="OnTabClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Seg}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DexMode}" Value="all">
                                            <Setter Property="Background" Value="{DynamicResource Text}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnText}"/>
                                            <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="카테고리별" CommandParameter="cat" Click="OnTabClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Seg}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DexMode}" Value="cat">
                                            <Setter Property="Background" Value="{DynamicResource Pink}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnPink}"/>
                                            <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <CheckBox Style="{StaticResource DexCheck}" Content="미보유만" IsChecked="{Binding DexOnlyMissing}" AutomationProperties.Name="미보유만"/>
                    <Button x:Name="SortBtn" Style="{StaticResource SortButton}" Content="{Binding DexSort}" Margin="16,0,0,0" Click="OnSortClick"
                            ToolTip="정렬" AutomationProperties.Name="정렬"/>
                    <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortBtn}" Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                        <!-- 바깥 여백은 그림자 자리 -->
                        <Border Margin="16,6,16,30" Background="{DynamicResource Elev}" BorderBrush="{DynamicResource ElevRing}" BorderThickness="1" CornerRadius="12" Padding="0,4"
                                MinWidth="96" Effect="{DynamicResource FloatShadow}" TextElement.FontFamily="{StaticResource AppFont}" v:Motion.Enter="Menu" PreviewKeyDown="OnSortKeyDown">
                            <ItemsControl x:Name="SortMenu" ItemsSource="{Binding DexSortOptions}" ItemTemplate="{StaticResource SortItem}" Focusable="False"/>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- 정령 목록 -->
            <ScrollViewer x:Name="DexHost" Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="-4,0,-14,0" Padding="4,0,14,0" Focusable="False" PreviewKeyDown="OnDexKeyDown">
                <StackPanel x:Name="DexBody" VerticalAlignment="Top" Margin="0,4,0,14">
                    <!-- 전체 -->
                    <ItemsControl x:Name="AllGrid" Tag="cards" ItemsSource="{Binding Spirits}" ItemTemplate="{StaticResource SpiritCell}" ItemsPanel="{StaticResource CardGrid}" Margin="-6,0" Focusable="False"
                                  Visibility="{Binding DexMode, Converter={StaticResource EqVis}, ConverterParameter=all}"/>
                    <!-- 카테고리별: 색 띠 머리 + 정령들 (빈 카테고리도 보인다) -->
                    <ItemsControl x:Name="CatList" ItemsSource="{Binding SpiritGroups}" Focusable="False"
                                  Visibility="{Binding DexMode, Converter={StaticResource EqVis}, ConverterParameter=cat}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SpiritGroup}">
                                <Grid Margin="0,0,0,22">
                                    <Border Background="{DynamicResource Card}" CornerRadius="18" Effect="{DynamicResource CardShadow}"/>
                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18">
                                        <StackPanel>
                                            <Border x:Name="head" CornerRadius="17,17,0,0" Padding="18,12" Background="{Binding HeadBg}" TextElement.Foreground="{Binding HeadFg}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="ExtraBold"/>
                                                    <TextBlock Text="{Binding CountText}" FontSize="13" Opacity="0.8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl Tag="cards" ItemsSource="{Binding Spirits}" ItemTemplate="{StaticResource SpiritCell}" ItemsPanel="{StaticResource CardGrid}" Margin="10,16,10,2" Focusable="False"
                                                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>
                                            <TextBlock Text="{Binding EmptyText}" FontSize="13" Foreground="{DynamicResource Text2}" Margin="20,22,20,22"
                                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsDark, RelativeSource={RelativeSource AncestorType={x:Type v:DexView}}}" Value="True">
                                        <Setter TargetName="head" Property="Background" Value="{Binding HeadBgDark}"/>
                                        <Setter TargetName="head" Property="TextElement.Foreground" Value="{Binding HeadFgDark}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 전체 보기에서 보여 줄 정령이 없을 때 -->
                    <StackPanel Margin="0,36,0,22" HorizontalAlignment="Center" Visibility="{Binding DexAllEmpty, Converter={StaticResource BoolVis}}">
                        <Image x:Name="EmptyArt" Source="/Assets/spirit_neutral.png" Width="84" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="모든 정령을 만났어요!" FontSize="14" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 정령 정보 / 힌트 -->
        <Border x:Name="PanelEdge" Grid.Column="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0" Margin="0,0,-26,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding DexPanelTitle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="정령을 선택해 주세요" FontSize="14" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasSelectedSpirit, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding HasSelectedSpirit, Converter={StaticResource BoolVis}}">
                    <StackPanel x:Name="PanelBody" Margin="22,4,22,20">
                        <!-- 그림: 1.15:1, 가운데가 은은히 밝다 -->
                        <Grid x:Name="Hero" Margin="0,4,0,0" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Ratio}, ConverterParameter=0.8696}">
                            <Border CornerRadius="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                                        <Style.Triggers>
                                            <!-- 다크: 캡처에서 잘라 쓴 그림에 흰 바탕이 있어 만난 정령의 칸만 밝게 둔다 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDark}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedSpirit.Owned}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource DarkHeroBase}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border CornerRadius="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource HeroGlow}"/>
                                        <Setter Property="OpacityMask" Value="{StaticResource GlowMask}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DarkHintGlow}"/>
                                                <Setter Property="OpacityMask" Value="{StaticResource GlowMaskDark}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDark}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedSpirit.Owned}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource DarkHeroGlow}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border CornerRadius="18" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Image x:Name="HeroArt" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                   Width="{Binding ActualWidth, ElementName=Hero, Converter={StaticResource Ratio}, ConverterParameter=0.62}"
                                   Height="{Binding ActualWidth, ElementName=Hero, Converter={StaticResource Ratio}, ConverterParameter=0.62}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="{Binding SelectedSpirit.Art}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="Source" Value="{Binding SelectedSpirit.ArtDark}"/>
                                            </DataTrigger>
                                            <!-- 힌트: 흐린 실루엣 -->
                                            <DataTrigger Binding="{Binding SelectedSpirit.Owned}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDark}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedSpirit.Owned}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border Background="{DynamicResource LimeOp}" CornerRadius="11" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                    Visibility="{Binding SelectedSpirit.IsRepresentative, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="12" Height="12" Foreground="{DynamicResource LimeT}" VerticalAlignment="Center"/>
                                    <TextBlock Text="대표 정령" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding SelectedSpirit.Name}" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>

                        <!-- 만난 정령 -->
                        <StackPanel Visibility="{Binding SelectedSpirit.Owned, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                            <ItemsControl ItemsSource="{Binding SelectedSpirit.Hearts}" ItemTemplate="{StaticResource HeartBig}" ItemsPanel="{StaticResource Row}"
                                          HorizontalAlignment="Center" Focusable="False" Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding SelectedSpirit.AffectionText}" FontSize="12" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding SelectedSpirit.ShowNextHeart, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding SelectedSpirit.NextHeartText}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                                <ProgressBar Style="{StaticResource GradBar}" Margin="0,6,0,0" Value="{Binding SelectedSpirit.NextHeart, Mode=OneWay}"
                                             Foreground="{DynamicResource PinkOp}" BorderBrush="{DynamicResource Pink}" AutomationProperties.Name="다음 하트까지"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                                        Visibility="{Binding SelectedSpirit.ShowHeartsFull, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                <TextBlock Text="호감도가 가득 찼어요" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource IcHeart}" Stretch="Uniform" Width="13" Height="13" Margin="5,0,0,0" Fill="{StaticResource HeartOn}" Stroke="{StaticResource HeartOnB}"
                                      StrokeThickness="0.8" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid MinHeight="42" Margin="16,0">
                                        <TextBlock Text="속성" Style="{StaticResource InfoKey}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding SelectedSpirit.ElementBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedSpirit.Element}" FontSize="13" FontWeight="Bold" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Stroke}"/>
                                    <Grid MinHeight="42" Margin="16,0">
                                        <TextBlock Text="카테고리" Style="{StaticResource InfoKey}"/>
                                        <TextBlock Text="{Binding SelectedSpirit.Category}" Style="{StaticResource InfoValue}"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Stroke}"/>
                                    <Grid MinHeight="42" Margin="16,0">
                                        <TextBlock Text="처음 만난 날" Style="{StaticResource InfoKey}"/>
                                        <TextBlock Text="{Binding SelectedSpirit.FirstMet}" Style="{StaticResource InfoValue}"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Stroke}"/>
                                    <Grid MinHeight="42" Margin="16,0">
                                        <TextBlock Text="함께한 날" Style="{StaticResource InfoKey}"/>
                                        <TextBlock Text="{Binding SelectedSpirit.DaysText}" Style="{StaticResource InfoValue}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Padding="16,14" Margin="0,14,0,0">
                                <TextBlock Text="{Binding SelectedSpirit.Description}" FontSize="14" TextWrapping="Wrap" TextTrimming="None" LineHeight="23.8"/>
                            </Border>
                        </StackPanel>

                        <!-- 아직 못 만난 정령: 힌트 -->
                        <StackPanel Visibility="{Binding SelectedSpirit.Unknown, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                            <Border Background="{DynamicResource Back02}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock Text="{Binding SelectedSpirit.Category}" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <Grid Margin="0,14,0,0">
                                <Rectangle RadiusX="18" RadiusY="18" Fill="{DynamicResource Card}" Stroke="{DynamicResource CarryB}" StrokeThickness="1" StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
                                <StackPanel Margin="16">
                                    <TextBlock Text="이 정령을 만나려면" FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedSpirit.Hint}" FontSize="15" TextWrapping="Wrap" TextTrimming="None" LineHeight="25.5"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SelectedSpirit.CategoryProgressText}" FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,14,0,0"/>
                            <ProgressBar Style="{StaticResource GradBar}" Margin="0,6,0,0" Maximum="{Binding SelectedSpirit.CategoryTotal, Mode=OneWay, FallbackValue=1}"
                                         Value="{Binding SelectedSpirit.CategoryOwned, Mode=OneWay, FallbackValue=0}"
                                         Foreground="{DynamicResource PinkOp}" BorderBrush="{DynamicResource Pink}" AutomationProperties.Name="카테고리에서 만난 정령"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 대표 정령으로 설정 -->
                <StackPanel Grid.Row="2" Margin="22,14,22,22" Visibility="{Binding SelectedSpirit.Owned, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}}" IsEnabled="{Binding CanUseAccount}">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="이름 저장" Click="OnRename" Style="{StaticResource Pill}" Margin="6,0,0,0"/>
                            <TextBox x:Name="SpiritNameInput" Text="{Binding SelectedSpirit.Name, Mode=OneWay}" MaxLength="50" AutomationProperties.Name="정령 이름"/>
                        </DockPanel>
                        <Button Content="{Binding SelectedSpirit.ImportantButtonText}" Click="OnFavorite" Style="{StaticResource Pill}" Margin="0,0,0,6"/>
                    </StackPanel>
                    <Button Content="{Binding RepresentativeLabel}" Command="{Binding SetRepresentativeCommand}" Click="OnSetRepresentativeClick" v:Ui.IconSize="16">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSpirit.IsRepresentative}" Value="True">
                                        <Setter Property="Tag" Value="{StaticResource IcCheck}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="카드를 두 번 누르거나 Enter로도 바꿀 수 있어요" FontSize="11" Foreground="{DynamicResource Grey}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
