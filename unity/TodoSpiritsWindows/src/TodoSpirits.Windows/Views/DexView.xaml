<UserControl x:Class="TodoSpirits.Windows.Views.DexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
             xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels">
    <UserControl.Resources>
        <!-- 하트 5개: 채워진 것은 핑크, 빈 것은 흐린 색 -->
        <DataTemplate x:Key="Heart">
            <v:Icon x:Name="h" Data="{StaticResource IcHeart}" Filled="True" Thickness="1" Width="14" Height="14" Foreground="{DynamicResource HeartOff}" Margin="1,0"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter TargetName="h" Property="Foreground" Value="{DynamicResource Pink}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Row">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- 도감 한 칸 -->
        <DataTemplate x:Key="SpiritCell" DataType="{x:Type vm:SpiritRow}">
            <Button Cursor="Hand" Margin="6,0,6,14" ToolTip="{Binding Tip}" FocusVisualStyle="{StaticResource FocusRing}" MouseDoubleClick="OnSpiritDoubleClick"
                    Command="{Binding DataContext.SelectSpiritCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Background="Transparent">
                            <Border x:Name="frame" Background="{DynamicResource Frame}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Height="132">
                                <Grid>
                                    <Image Source="{Binding Art}" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Owned, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="?" FontSize="44" FontWeight="ExtraBold" Foreground="{DynamicResource Grey}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Unknown, Converter={StaticResource BoolVis}}"/>
                                    <Border Background="{DynamicResource Lime}" CornerRadius="13" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                            ToolTip="대표 정령" Visibility="{Binding IsRepresentative, Converter={StaticResource BoolVis}}">
                                        <v:Icon Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="14" Height="14" Foreground="{DynamicResource OnLime}"/>
                                    </Border>
                                    <Border Background="#FFFFFF" CornerRadius="9" Padding="6,1,8,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                            Visibility="{Binding HasElement, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding ElementBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Element}" FontSize="11" FontWeight="ExtraBold" Foreground="#665646" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="nm" Text="{Binding Name}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,3"/>
                            <ItemsControl ItemsSource="{Binding Hearts}" ItemTemplate="{StaticResource Heart}" ItemsPanel="{StaticResource Row}" HorizontalAlignment="Center" Focusable="False"
                                          Visibility="{Binding Owned, Converter={StaticResource BoolVis}, ConverterParameter=hide}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Owned}" Value="False">
                                <Setter TargetName="frame" Property="Background" Value="{DynamicResource PanelBg}"/>
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource Grey}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                                <Setter TargetName="frame" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="정령 도감" FontSize="26" FontWeight="ExtraBold" Margin="2,16,0,14"/>

            <StackPanel Grid.Row="1">
            <!-- 대표 정령 · 만난 정령 -->
                <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource Frame}">
                                <Image Source="{Binding Representative.Art}" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="대표 정령" FontSize="12" Foreground="{DynamicResource Text2}"/>
                                <TextBlock Text="{Binding Representative.Name}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="220">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="만난 정령" FontSize="12" Foreground="{DynamicResource Text2}"/>
                                <TextBlock Text="{Binding SpiritsProgress}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="{Binding SpiritsTotal, Mode=OneWay}" Value="{Binding SpiritsOwned, Mode=OneWay}" Height="8"
                                         Foreground="{DynamicResource Pink}" Background="{DynamicResource SwitchOff}" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- 보기 방식: 전체 / 카테고리별, 미보유만 -->
                <Grid Margin="0,0,0,16">
                    <Border Background="{DynamicResource Back02}" CornerRadius="18" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="전체" Command="{Binding SetDexModeCommand}" CommandParameter="all">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Flat}">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="22,7"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DexMode}" Value="all">
                                                <Setter Property="Background" Value="{DynamicResource Text}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource OnText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="카테고리별" Command="{Binding SetDexModeCommand}" CommandParameter="cat">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Flat}">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="22,7"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DexMode}" Value="cat">
                                                <Setter Property="Background" Value="{DynamicResource Pink}"/>
                                                <Setter Property="Foreground" Value="#3A2E24"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding DexSortLabel}" Tag="{StaticResource IcRepeat}" Style="{StaticResource Flat}" ToolTip="정렬 바꾸기" AutomationProperties.Name="정렬 바꾸기"
                                Margin="0,0,12,0" Command="{Binding NextDexSortCommand}"/>
                        <TextBlock Text="미보유만" FontSize="14" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DexOnlyMissing}" AutomationProperties.Name="미보유만"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                <StackPanel VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding Spirits}" ItemTemplate="{StaticResource SpiritCell}" Margin="-6,0" Focusable="False"
                                  Visibility="{Binding DexMode, Converter={StaticResource EqVis}, ConverterParameter=all}" v:Motion.Enter="Up">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding SpiritGroups}" Focusable="False"
                                  Visibility="{Binding DexMode, Converter={StaticResource EqVis}, ConverterParameter=cat}" v:Motion.Enter="Up">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SpiritGroup}">
                                <Border Style="{StaticResource CardBorder}" Padding="14,10,14,0" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="ExtraBold"/>
                                            <TextBlock Text="{Binding CountText}" FontSize="13" Foreground="{DynamicResource Text2}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Spirits}" ItemTemplate="{StaticResource SpiritCell}" Margin="-6,0" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="모든 정령을 만났어요" FontSize="14" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,30,0,0"
                               Visibility="{Binding DexEmpty, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Grey}" Margin="4,6,0,14"
                       Text="정령을 만나는 규칙과 호감도는 아직 앱에 연결되지 않았어요. 지금 보이는 정령 · 호감도 · 날짜는 예시예요."/>
        </Grid>

        <!-- 정령 정보 / 힌트 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0" Margin="0,0,-26,0">
            <Grid Margin="22,0,22,22" DataContext="{Binding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 만난 정령 -->
                <TextBlock Text="정령 정보" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedSpirit.Owned, Converter={StaticResource BoolVis}}"/>
                <StackPanel Grid.Row="1" Visibility="{Binding SelectedSpirit.Owned, Converter={StaticResource BoolVis}}">
                    <Border Background="{DynamicResource Frame}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" Height="200">
                        <Image Source="{Binding SelectedSpirit.Art}" Width="150" Height="150" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="{Binding SelectedSpirit.Name}" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                    <ItemsControl ItemsSource="{Binding SelectedSpirit.Hearts}" ItemsPanel="{StaticResource Row}" HorizontalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <v:Icon x:Name="h" Data="{StaticResource IcHeart}" Filled="True" Thickness="1" Width="20" Height="20" Foreground="{DynamicResource HeartOff}" Margin="2,0"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="True">
                                        <Setter TargetName="h" Property="Foreground" Value="{DynamicResource Pink}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SelectedSpirit.AffectionText}" FontSize="12" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                    <TextBlock Text="{Binding SelectedSpirit.NextHeartText}" FontSize="12" Foreground="{DynamicResource Text2}" Margin="4,0,0,6"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SelectedSpirit.NextHeart, Mode=OneWay}" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource CardBorder}" Padding="16,2">
                        <StackPanel>
                            <Grid Height="40">
                                <TextBlock Text="속성" FontSize="13" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding SelectedSpirit.ElementBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedSpirit.Element}" FontSize="13" FontWeight="Bold" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}"/>
                            <Grid Height="40">
                                <TextBlock Text="카테고리" FontSize="13" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedSpirit.Category}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}"/>
                            <Grid Height="40">
                                <TextBlock Text="처음 만난 날" FontSize="13" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedSpirit.FirstMet}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectedSpirit.Description}" FontSize="14" TextWrapping="Wrap" TextTrimming="None" LineHeight="22" Margin="6,14,6,0"/>
                </StackPanel>
                <Button Grid.Row="2" Style="{StaticResource Primary}" Content="{Binding RepresentativeLabel}" Command="{Binding SetRepresentativeCommand}"
                        Visibility="{Binding SelectedSpirit.Owned, Converter={StaticResource BoolVis}}"/>

                <!-- 아직 못 만난 정령: 힌트 -->
                <TextBlock Text="힌트" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedSpirit.Unknown, Converter={StaticResource BoolVis}}"/>
                <StackPanel Grid.Row="1" Visibility="{Binding SelectedSpirit.Unknown, Converter={StaticResource BoolVis}}">
                    <Border Background="{DynamicResource Back02}" BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1" CornerRadius="18" Height="200">
                        <TextBlock Text="?" FontSize="72" FontWeight="ExtraBold" Foreground="{DynamicResource Grey}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="???" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Text="{Binding SelectedSpirit.Category}" FontSize="13" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource CardBorder}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="이 정령을 만나려면" FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedSpirit.Hint}" FontSize="15" TextWrapping="Wrap" TextTrimming="None" LineHeight="23"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
