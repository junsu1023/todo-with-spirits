<UserControl x:Class="TodoSpirits.Windows.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views">
    <UserControl.Resources>
        <Style x:Key="SectionIcon" TargetType="v:Icon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 머리: 인사 · 날짜 · 검색 -->
        <Grid Margin="2,14,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Greeting}" FontSize="13" Foreground="{DynamicResource Text2}"/>
                <TextBlock Text="{Binding TodayText}" FontSize="26" FontWeight="ExtraBold" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="240" Height="38" FontSize="14" Margin="0,0,6,0" AutomationProperties.Name="일정 검색"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding SearchOpen, Converter={StaticResource BoolVis}}" IsVisibleChanged="OnSearchVisible" v:Motion.Enter="Fade"/>
                <Button Style="{StaticResource IconBtn}" Tag="{StaticResource IcSearch}" ToolTip="검색 (Ctrl+F)" AutomationProperties.Name="검색"
                        Command="{Binding ToggleSearchCommand}"/>
                <Grid VerticalAlignment="Center">
                    <Button Style="{StaticResource IconBtn}" Tag="{StaticResource IcBell}" ToolTip="알림" AutomationProperties.Name="알림" Command="{Binding ToggleNotiCommand}"/>
                    <Border Background="{DynamicResource Pink}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" IsHitTestVisible="False"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding UnreadBadge}" FontSize="10" FontWeight="ExtraBold" Foreground="#3A2E24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 오늘 일정 요약 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Background="{DynamicResource SummaryTint}" Padding="22,16" Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="오늘 일정" FontSize="14" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding TodayDone}" FontSize="40" FontWeight="ExtraBold"/>
                        <TextBlock FontSize="20" Foreground="{DynamicResource Text2}" VerticalAlignment="Bottom" Margin="8,0,0,7">
                            <Run Text="/ "/><Run Text="{Binding TodayTotal, Mode=OneWay}"/><Run Text=" 완료"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HasNext, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource LimeTag}" HorizontalAlignment="Right">
                        <TextBlock Text="다음 일정" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource LimeT}"/>
                    </Border>
                    <TextBlock Text="{Binding NextTitle}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0" MaxWidth="320"/>
                    <TextBlock Text="{Binding NextWhen}" FontSize="13" Foreground="{DynamicResource Text2}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 칩: 중요 일정 · 완료 숨기기 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{DynamicResource PinkOp}" CornerRadius="16" Padding="12,6" Margin="0,0,8,0"
                    Visibility="{Binding HasImportantLeft, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <v:Icon Data="{StaticResource IcStar}" Filled="True" Thickness="1.2" Width="13" Height="13" Foreground="{DynamicResource Pink}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ImportantChip}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PinkB}"/>
                </StackPanel>
            </Border>
            <Button Content="{Binding DoneChip}" Tag="{StaticResource IcCheck}" Command="{Binding ToggleHideDoneCommand}" ToolTip="완료한 일정 숨기기 / 보이기"
                    Visibility="{Binding HasDoneToday, Converter={StaticResource BoolVis}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Pill}">
                        <Setter Property="Background" Value="{DynamicResource LimeOp}"/>
                        <Setter Property="Foreground" Value="{DynamicResource LimeT}"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HomeHideDone}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Back02}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Button Grid.Row="3" Style="{StaticResource Primary}" Content="일정 추가" Tag="{StaticResource IcPlus}" Command="{Binding AddCommand}" ToolTip="Ctrl+N"
                AutomationProperties.Name="일정 추가" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" Padding="0,0,16,0">
            <StackPanel Margin="0,0,0,24">
                <!-- 어제 하지 못한 일 -->
                <StackPanel Visibility="{Binding HasCarry, Converter={StaticResource BoolVis}}">
                    <Grid Margin="4,2,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <v:Icon Data="{StaticResource IcCal}" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="어제 하지 못한 일" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CarryCount}" FontSize="14" Foreground="{DynamicResource Text2}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Content="모두 오늘 하기" Style="{StaticResource Pill}" HorizontalAlignment="Right" Command="{Binding MoveAllToTodayCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Carry}" ItemTemplate="{StaticResource CarryCard}" Focusable="False"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasTimed, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,10">
                        <v:Icon Data="{StaticResource IcClock}" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="시간 일정" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TimedCount}" FontSize="14" Foreground="{DynamicResource Text2}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Timed}" ItemTemplate="{StaticResource TaskCard}" Focusable="False"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasAllDay, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,10">
                        <v:Icon Data="{StaticResource IcSun}" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="하루 종일" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AllDayCount}" FontSize="14" Foreground="{DynamicResource Text2}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AllDay}" ItemTemplate="{StaticResource TaskCard}" Focusable="False"/>
                </StackPanel>

                <StackPanel Margin="0,50,0,0" HorizontalAlignment="Center" Visibility="{Binding HomeEmpty, Converter={StaticResource BoolVis}}">
                    <Image Source="/Assets/spirit_neutral.png" Width="96" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="일정을 추가해보세요!" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,50,0,0" HorizontalAlignment="Center" Visibility="{Binding HomeNoMatch, Converter={StaticResource BoolVis}}">
                    <v:Icon Data="{StaticResource IcSad}" Width="40" Height="40" Foreground="{DynamicResource Grey}" HorizontalAlignment="Center"/>
                    <TextBlock Text="검색한 일정이 없어요" FontSize="15" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
