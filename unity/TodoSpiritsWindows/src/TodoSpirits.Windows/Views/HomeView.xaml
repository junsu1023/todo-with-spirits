<UserControl x:Class="TodoSpirits.Windows.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views">
    <!-- 홈 (시안 home-v4.html): 머리 74 · 요약 · 칩 · 일정 추가 · 네 구역(어제 하지 못한 일 / 시간 일정 / 할 일 / 완료) -->
    <UserControl.Resources>
        <Style x:Key="SectionIcon" TargetType="v:Icon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SectionCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <!-- 칩 (.chip): 높이 30 알약 -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="v:Ui.Radius" Value="15"/>
            <Setter Property="v:Ui.IconSize" Value="15"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Rows" v:Motion.Stagger="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 머리: 인사 · 날짜 · 검색 · 알림 -->
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Greeting}" FontSize="13" Foreground="{DynamicResource Text2}"/>
                <TextBlock Text="{Binding TodayText}" FontSize="26" FontWeight="ExtraBold" Margin="0,2,0,0"/>
            </StackPanel>
            <v:HeaderTools HorizontalAlignment="Right"/>
        </Grid>

        <!-- 오늘 일정 요약: 남은 수 / 전체 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Background="{DynamicResource SummaryTint}" Padding="24,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="오늘 일정" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" ToolTip="남은 일정 / 오늘 전체">
                        <TextBlock x:Name="LeftNum" Text="{Binding TodayLeft}" FontSize="52" FontWeight="ExtraBold" LineHeight="52" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock FontSize="22" Foreground="{DynamicResource Text2}" VerticalAlignment="Bottom" Margin="8,0,0,4">
                            <Run Text="/ "/><Run Text="{Binding TodayTotal, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="{Binding HasNext, Converter={StaticResource BoolVis}}">
                    <Border Background="{DynamicResource LimeOp}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Right">
                        <TextBlock Text="다음 일정" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LimeT}"/>
                    </Border>
                    <TextBlock Text="{Binding NextTitle}" FontSize="14" HorizontalAlignment="Right" Margin="0,5,0,0" MaxWidth="320"/>
                    <TextBlock Text="{Binding NextWhen}" FontSize="13" Foreground="{DynamicResource Text2}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock Text="남은 시간 일정이 없어요" FontSize="13" Foreground="{DynamicResource Text2}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                           Visibility="{Binding NoNext, Converter={StaticResource BoolVis}}"/>
            </Grid>
        </Border>

        <!-- 칩: 중요 일정만 보기 · 완료 보이기/숨기기 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,16">
            <Button Content="{Binding ImportantChip}" ToolTip="중요 일정만 보기 / 모두 보기" AutomationProperties.Name="중요 일정만 보기" Margin="0,0,8,0"
                    Command="{Binding ToggleOnlyImportantCommand}" Visibility="{Binding HasImportantLeft, Converter={StaticResource BoolVis}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                        <Setter Property="Background" Value="{DynamicResource PinkOp}"/>
                        <Setter Property="Foreground" Value="{DynamicResource PinkB}"/>
                        <Setter Property="Tag" Value="{StaticResource IcStar}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OnlyImportant}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Pink}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPink}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding DoneChip}" Tag="{StaticResource IcCheck}" Command="{Binding ToggleHideDoneCommand}" ToolTip="완료한 일정 보이기 / 숨기기" AutomationProperties.Name="완료 보이기"
                    Visibility="{Binding HasTodayTasks, Converter={StaticResource BoolVis}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                        <Setter Property="Background" Value="{DynamicResource LimeOp}"/>
                        <Setter Property="Foreground" Value="{DynamicResource LimeT}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HomeHideDone}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Back02}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Button Grid.Row="3" Style="{StaticResource Primary}" Content="일정 추가" Tag="{StaticResource IcPlus}" Command="{Binding AddCommand}" ToolTip="Ctrl+N"
                AutomationProperties.Name="일정 추가" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="-6,0,-16,0" Padding="6,0,16,0">
            <StackPanel Margin="0,0,0,24">
                <!-- 어제 하지 못한 일 -->
                <StackPanel Visibility="{Binding HasCarry, Converter={StaticResource BoolVis}}">
                    <Grid Margin="4,2,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <v:Icon Data="{StaticResource IcCal}" Style="{StaticResource SectionIcon}"/>
                            <TextBlock Text="어제 하지 못한 일" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding CarryCount}" Style="{StaticResource SectionCount}"/>
                        </StackPanel>
                        <Button Content="모두 오늘 하기" Style="{StaticResource Pill}" HorizontalAlignment="Right" Command="{Binding MoveAllToTodayCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Carry}" ItemTemplate="{StaticResource CarryCard}" Focusable="False" v:Motion.Stagger="True"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasTimed, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,10">
                        <v:Icon Data="{StaticResource IcClock}" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="시간 일정" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding TimedCount}" Style="{StaticResource SectionCount}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Timed}" ItemTemplate="{StaticResource TaskCard}" Focusable="False" v:Motion.Stagger="True"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasAllDay, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,10">
                        <v:Icon Data="{StaticResource IcCheck}" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="할 일" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding AllDayCount}" Style="{StaticResource SectionCount}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AllDay}" ItemTemplate="{StaticResource TaskCard}" Focusable="False" v:Motion.Stagger="True"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasDoneRows, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="4,8,0,10">
                        <v:Icon Data="{StaticResource IcCheck}" Style="{StaticResource SectionIcon}"/>
                        <TextBlock Text="완료" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding DoneRowsCount}" Style="{StaticResource SectionCount}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding DoneRows}" ItemTemplate="{StaticResource TaskCard}" Focusable="False" v:Motion.Stagger="True"/>
                </StackPanel>

                <StackPanel Margin="0,44,0,0" HorizontalAlignment="Center" Visibility="{Binding HomeEmpty, Converter={StaticResource BoolVis}}">
                    <Image Source="/Assets/spirit_neutral.png" Width="84" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality" v:Motion.Float="True"/>
                    <TextBlock Text="일정을 추가해보세요!" FontSize="14" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,44,0,0" HorizontalAlignment="Center" Visibility="{Binding HomeNoMatch, Converter={StaticResource BoolVis}}">
                    <Image Source="/Assets/spirit_neutral.png" Width="84" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality" v:Motion.Float="True"/>
                    <TextBlock Text="{Binding HomeNoMatchText}" FontSize="14" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
