<Window x:Class="TodoSpirits.Windows.Views.SpiritPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="정령" Width="300" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="True"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" Deactivated="OnDeactivated" KeyDown="OnKeyDown">
    <!-- 바탕화면 정령 옆에 뜨는 작은 창: 좌클릭 = 오늘 일정, 우클릭 = 메뉴 -->
    <Border Margin="14" CornerRadius="20" Background="{DynamicResource Elev}" BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Color="#5A4632"/>
        </Border.Effect>
        <Grid>
            <!-- 오늘 일정 -->
            <StackPanel x:Name="TodayPane">
                <Grid Margin="4,0,0,8">
                    <StackPanel>
                        <TextBlock Text="오늘 일정" FontSize="16" FontWeight="ExtraBold"/>
                        <TextBlock Text="{Binding TodayStat}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                    </StackPanel>
                    <Button Content="앱 열기" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnOpenApp"/>
                </Grid>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TodayRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Check}" Tag="{Binding Done}" ToolTip="완료 표시"
                                                Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="t" Text="{Binding Title}" FontSize="14" FontWeight="Bold" MaxWidth="170"/>
                                                <TextBlock Text="★" Foreground="{DynamicResource Pink}" FontSize="13" Margin="5,0,0,0"
                                                           Visibility="{Binding Important, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource Text2}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="t" Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Text2}"/>
                                        <Setter TargetName="t" Property="FontWeight" Value="Normal"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="오늘은 일정이 없어요" FontSize="13" Foreground="{DynamicResource Grey}" Margin="4,4,0,8"
                           Visibility="{Binding TodayEmpty, Converter={StaticResource BoolVis}}"/>
                <Button Content="+  일정 추가" Style="{StaticResource Primary}" Height="42" FontSize="14" Margin="0,4,0,0" Click="OnAdd"/>
            </StackPanel>

            <!-- 우클릭 메뉴 -->
            <StackPanel x:Name="MenuPane" Visibility="Collapsed">
                <Button Content="오늘 일정 보기" Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Height="40" Click="OnShowToday"/>
                <Button Content="일정 추가" Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Height="40" Click="OnAdd"/>
                <Button Content="앱 열기" Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Height="40" Click="OnOpenApp"/>
                <Border Height="1" Background="{DynamicResource Stroke}" Margin="6,4"/>
                <Button Content="정령 쉬게 하기" Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Height="40" Click="OnRest" ToolTip="설정 › 디스플레이에서 다시 부를 수 있어요"/>
                <Button Content="앱 종료" Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Height="40" Foreground="{DynamicResource Del}" Click="OnQuit"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
