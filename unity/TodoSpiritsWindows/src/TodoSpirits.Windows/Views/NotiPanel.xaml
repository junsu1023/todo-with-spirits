<UserControl x:Class="TodoSpirits.Windows.Views.NotiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views"
             xmlns:vm="clr-namespace:TodoSpirits.Windows.ViewModels">
    <!-- 알림 패널: 울린 일정 알림이 쌓인다. 누르면 그 일정을 연다 -->
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0">
        <Grid Margin="22,0,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="알림" FontSize="20" FontWeight="ExtraBold"/>
                    <Border Background="{DynamicResource PinkOp}" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding UnreadBadge}" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource PinkB}"/>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" Tag="{StaticResource IcX}" HorizontalAlignment="Right" ToolTip="닫기 (Esc)" AutomationProperties.Name="알림 닫기"
                        Command="{Binding ToggleNotiCommand}"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="모두 읽음" Tag="{StaticResource IcCheck}" Style="{StaticResource Pill}" Command="{Binding ReadAllNotiCommand}"/>
                <Button Content="모두 지우기" Tag="{StaticResource IcTrash}" Style="{StaticResource Pill}" Margin="8,0,0,0" Command="{Binding ClearNotiCommand}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Notifications}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NotiRow}">
                                <Button Style="{StaticResource CardButton}" ToolTip="이 일정 열기"
                                        Command="{Binding DataContext.OpenNotiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource LimeOp}" VerticalAlignment="Top">
                                            <v:Icon Data="{StaticResource IcBell}" Width="17" Height="17" Foreground="{DynamicResource LimeT}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="t" Text="{Binding Title}" FontSize="14" FontWeight="Bold" MaxWidth="190"/>
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Pink}" Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="읽지 않음"
                                                         Visibility="{Binding Unread, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Body}" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                                            <TextBlock Text="{Binding Ago}" FontSize="12" Foreground="{DynamicResource Grey}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="28" Height="28" Tag="{StaticResource IcX}" VerticalAlignment="Top" ToolTip="이 알림 지우기"
                                                Foreground="{DynamicResource Text2}"
                                                Command="{Binding DataContext.DeleteNotiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Unread}" Value="False">
                                        <Setter TargetName="t" Property="FontWeight" Value="Normal"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Text2}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" Visibility="{Binding NotiEmpty, Converter={StaticResource BoolVis}}">
                        <v:Icon Data="{StaticResource IcBell}" Width="36" Height="36" Foreground="{DynamicResource Grey}" HorizontalAlignment="Center"/>
                        <TextBlock Text="아직 알림이 없어요" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="일정에 시간과 알림을 정하면 여기에 쌓여요." FontSize="13" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
