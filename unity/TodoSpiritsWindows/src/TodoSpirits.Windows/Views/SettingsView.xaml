<UserControl x:Class="TodoSpirits.Windows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TodoSpirits.Windows.Views">
    <UserControl.Resources>
        <Style x:Key="PaneTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Margin" Value="4,0,0,14"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource RowNote}">
            <Setter Property="Margin" Value="6,10,6,0"/>
        </Style>
        <Style x:Key="Line" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Stroke}"/>
        </Style>
        <!-- 왼쪽 목록 -->
        <Style x:Key="SectionItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <!-- 화면 읽기 프로그램이 항목 이름을 읽을 수 있게 -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                        <TextBlock Text="{Binding Header}" FontSize="12" Foreground="{DynamicResource Text2}" Margin="12,8,0,6" Visibility="{Binding HasHeader, Converter={StaticResource BoolVis}}"/>
                        <Border x:Name="b" Background="Transparent" CornerRadius="12" Height="42" Padding="14,0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <v:Icon x:Name="ic" Data="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource Text2}" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="t" Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Back02}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                                <Setter TargetName="b" Property="Effect" Value="{StaticResource CardShadow}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="ExtraBold"/>
                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource LimeT}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="설정" FontSize="26" FontWeight="ExtraBold" Margin="2,16,0,14" Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="1" Margin="0,0,18,0">
            <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource PinkOp}">
                        <TextBlock Text="{Binding AvatarText}" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource PinkB}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nickname, TargetNullValue=닉네임 없음, FallbackValue=닉네임 없음}" FontSize="15" FontWeight="Bold" MaxWidth="130"/>
                        <TextBlock Text="이 컴퓨터에 저장" FontSize="12" Foreground="{DynamicResource Text2}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding Sections}" SelectedValuePath="Key" SelectedValue="{Binding SettingsSection}" ItemContainerStyle="{StaticResource SectionItem}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="설정 항목"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
            <Grid MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,24">

                <!-- 프로필 -->
                <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource EqVis}, ConverterParameter=profile}" v:Motion.Enter="Up">
                    <TextBlock Text="프로필" Style="{StaticResource PaneTitle}"/>
                    <TextBlock Text="닉네임" FontSize="13" Foreground="{DynamicResource Text2}" Margin="6,0,0,6"/>
                    <TextBox Height="50" MaxLength="10" Text="{Binding Nickname, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="닉네임" KeyDown="OnCommitOnEnter"/>
                    <TextBlock Text="{Binding NicknameCount}" FontSize="11" Foreground="{DynamicResource Grey}" HorizontalAlignment="Right" Margin="0,6,6,0"/>
                    <TextBlock Style="{StaticResource Note}" Text="최대 10자. 입력하고 Enter 를 누르거나 다른 곳을 누르면 저장돼요. 홈 인사말에 쓰여요."/>
                    <TextBlock Style="{StaticResource Note}" Text="계정 로그인 · 비밀번호 변경 · 회원탈퇴는 서버와 연결한 뒤에 넣을 예정이에요."/>
                </StackPanel>

                <!-- 디스플레이 -->
                <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource EqVis}, ConverterParameter=display}" v:Motion.Enter="Up">
                    <TextBlock Text="디스플레이 설정" Style="{StaticResource PaneTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="18,4">
                        <StackPanel>
                            <Grid MinHeight="56">
                                <TextBlock Text="다크모드" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsDark}" HorizontalAlignment="Right" AutomationProperties.Name="다크모드"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid MinHeight="56">
                                <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                                    <TextBlock Text="Windows 설정 따라가기" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="켜면 Windows 의 라이트/다크를 따라가요. 다크모드를 직접 바꾸면 꺼져요."/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FollowSystem}" HorizontalAlignment="Right" AutomationProperties.Name="Windows 설정 따라가기"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="18,4" Margin="0,12,0,0">
                        <Grid MinHeight="56">
                            <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                                <TextBlock Text="바탕화면 정령" Style="{StaticResource RowTitle}"/>
                                <TextBlock Style="{StaticResource RowNote}" Text="정령이 바탕화면을 돌아다녀요. 누르면 오늘 일정, 오른쪽 버튼으로 누르면 메뉴가 나와요."/>
                                <TextBlock Style="{StaticResource RowNote}" Text="{Binding SpiritStatusText}" Foreground="{DynamicResource LimeT}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SpiritEnabled}" HorizontalAlignment="Right" AutomationProperties.Name="바탕화면 정령"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="18,4" Margin="0,12,0,0">
                        <Grid MinHeight="56">
                            <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                                <TextBlock Text="글자 대비 높이기" Style="{StaticResource RowTitle}"/>
                                <TextBlock Style="{StaticResource RowNote}" Text="기본으로 켜져 있어요. 끄면 라이트 모드 글자가 Figma 원래 색(더 옅은 색)으로 바뀌어요."/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ContrastMore}" HorizontalAlignment="Right" AutomationProperties.Name="글자 대비 높이기"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 알림 -->
                <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource EqVis}, ConverterParameter=notify}" v:Motion.Enter="Up">
                    <TextBlock Text="알림 설정" Style="{StaticResource PaneTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="18,4">
                        <StackPanel>
                            <Grid Height="54">
                                <TextBlock Text="리마인드 알림" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyRemind}" HorizontalAlignment="Right" AutomationProperties.Name="리마인드 알림"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Height="54">
                                <TextBlock Text="미룬 플랜 정기 알림" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyPostponed}" HorizontalAlignment="Right" AutomationProperties.Name="미룬 플랜 정기 알림"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Height="54">
                                <TextBlock Text="루틴 안내 알림" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyRoutine}" HorizontalAlignment="Right" AutomationProperties.Name="루틴 안내 알림"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Height="54">
                                <TextBlock Text="스트릭(연속 달성) 세이브 알림" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyStreak}" HorizontalAlignment="Right" AutomationProperties.Name="스트릭 세이브 알림"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Height="54">
                                <TextBlock Text="야간 푸시 알림 수신" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyNight}" HorizontalAlignment="Right" AutomationProperties.Name="야간 푸시 알림 수신"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Note}" Text="리마인드 알림을 켜면 일정에 정해 둔 알림 시각에 Windows 알림이 떠요. 꺼도 앱의 알림 패널에는 쌓여요. 야간 푸시를 끄면 밤 10시부터 아침 8시까지는 Windows 알림을 띄우지 않아요."/>
                    <TextBlock Style="{StaticResource Note}" Text="미룬 플랜 · 루틴 · 스트릭 알림은 아직 고른 값만 기억해 둬요."/>
                    <Border Style="{StaticResource CardBorder}" Padding="18,4" Margin="0,14,0,0">
                        <Grid MinHeight="56">
                            <StackPanel VerticalAlignment="Center" Margin="0,8,60,8">
                                <TextBlock Text="창을 닫으면 트레이로" Style="{StaticResource RowTitle}"/>
                                <TextBlock Style="{StaticResource RowNote}" Text="켜면 창을 닫아도 앱이 트레이에 남아 알림과 정령이 유지돼요. 끝내려면 트레이 아이콘을 오른쪽 버튼으로 눌러 종료를 고르세요."/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" HorizontalAlignment="Right" AutomationProperties.Name="창을 닫으면 트레이로"/>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource Note}" Text="알림은 앱이 켜져 있을 때만 울려요. 앱을 완전히 끄면 알림도 오지 않아요."/>
                </StackPanel>

                <!-- 데이터 -->
                <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource EqVis}, ConverterParameter=data}" v:Motion.Enter="Up">
                    <TextBlock Text="데이터 설정" Style="{StaticResource PaneTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="일정이 저장되는 곳" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="{Binding TaskCountText}"/>
                            <TextBox Text="{Binding DataPath, Mode=OneWay}" IsReadOnly="True" Height="40" FontSize="12" Margin="0,10,0,10" AutomationProperties.Name="저장 위치"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="폴더 열기" Tag="{StaticResource IcDb}" Style="{StaticResource Pill}" Command="{Binding OpenDataFolderCommand}"/>
                                <Button Content="CSV 로 내보내기" Style="{StaticResource Pill}" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Note}" Text="일정은 이 컴퓨터에만 저장돼요. 백업 · 동기화는 서버와 연결한 뒤에 넣을 예정이에요."/>
                </StackPanel>

                <!-- 이용 안내 -->
                <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource EqVis}, ConverterParameter=guide}" v:Motion.Enter="Up">
                    <TextBlock Text="이용 안내" Style="{StaticResource PaneTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="1  일정을 추가해요" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" FontSize="13" Text="홈이나 캘린더의 &quot;+ 일정 추가&quot;를 누르거나 Ctrl+N 을 눌러요. 중요한 일정은 ★ 로 표시할 수 있어요."/>
                            <Border Style="{StaticResource Line}" Margin="0,12"/>
                            <TextBlock Text="2  일정을 끝내요" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" FontSize="13" Text="일정 왼쪽의 동그라미를 누르면 완료돼요. 잘못 눌렀으면 아래 &quot;되돌리기&quot;를 눌러요."/>
                            <Border Style="{StaticResource Line}" Margin="0,12"/>
                            <TextBlock Text="3  어제 못 한 일을 골라요" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" FontSize="13" Text="끝내지 못한 지난 일정은 홈의 &quot;어제 하지 못한 일&quot;에 모여요. 자동으로 넘어가지 않고, &quot;오늘 하기&quot;로 직접 골라요."/>
                            <Border Style="{StaticResource Line}" Margin="0,12"/>
                            <TextBlock Text="4  캘린더로 한눈에 봐요" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" FontSize="13" Text="주간 · 월간 · 연간으로 바꿔 볼 수 있어요. 월간에서 날짜를 두 번 누르면 그 날 일정을 추가해요."/>
                            <Border Style="{StaticResource Line}" Margin="0,12"/>
                            <TextBlock Text="5  반복과 알림을 정해요" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" FontSize="13" Text="일정을 열어 반복(매일 · 매주 · 매월)을 고르면 그 날짜마다 나타나요. 시간을 정한 일정은 알림 시각도 고를 수 있어요."/>
                        </StackPanel>
                    </Border>
                    <Button Content="단축키 보기" Tag="{StaticResource IcKeys}" Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ToggleHelpCommand}"/>
                </StackPanel>

                <!-- 앱 정보 -->
                <StackPanel Visibility="{Binding SettingsSection, Converter={StaticResource EqVis}, ConverterParameter=about}" v:Motion.Enter="Up">
                    <TextBlock Text="앱 정보" Style="{StaticResource PaneTitle}"/>
                    <Border Style="{StaticResource CardBorder}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Todo with Spirits" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="{Binding VersionText}"/>
                            <Border Style="{StaticResource Line}" Margin="0,12"/>
                            <TextBlock Text="글꼴" Style="{StaticResource RowTitle}"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="나눔스퀘어라운드 — SIL Open Font License 1.1"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Note}" Text="공지사항 · QnA · 약관 및 정책은 서버와 연결한 뒤에 넣을 예정이에요."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
